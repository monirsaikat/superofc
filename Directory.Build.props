<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1515 (make types internal) and CA1848 (LoggerMessage) are too noisy for an app codebase. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1716;CA1711;CA1720;CA2007;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1724;CA1819;CA2227;CA1002;CA1034;CA1056;CA1054;CA1055;CA2234;CA1707;CA1812;CA1822;CA1861;CA2000;CA1000;CA2225;CA1008;CA1028;CA1032;CA1064;CA1873;CA1863;CA1826;CA1859;CA1862</NoWarn>
    <Version>0.1.0</Version>
    <Company>SuperOfc</Company>
    <Product>SuperOfc</Product>
    <Copyright>Copyright (c) SuperOfc</Copyright>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
