<Project Sdk="Microsoft.NET.Sdk">
  <!--
    32-bit host for the ZKTeco COM SDK (ADR-06). Targets .NET Framework 4.8, which ships with Windows 10 1903+
    and Windows 11, so the installer does not carry a second runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <RootNamespace>SuperOfc.DeviceBridge</RootNamespace>
    <AssemblyName>SuperOfc.DeviceBridge</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Restore both: publishing the desktop app with -r win-x64 restores this project under that RID too. -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuperOfc.DeviceBridge.Contracts\SuperOfc.DeviceBridge.Contracts.csproj" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- Optional: the ZKTeco SDK files (not in source control, see sdk/README.md). -->
    <None Include="sdk\**\*" Exclude="sdk\README.md" CopyToOutputDirectory="PreserveNewest" LinkBase="sdk" />
    <None Include="fake\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="fake" />
  </ItemGroup>
</Project>
