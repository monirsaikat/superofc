<UserControl
    x:Class="SuperOfc.Desktop.Views.Tax.TaxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource BodyText}" Text="{x:Static res:Strings.Tax_FiscalYear}" />
        <ComboBox Width="130" DisplayMemberPath="Text" ItemsSource="{Binding FiscalYears}" SelectedValue="{Binding FiscalYear}" SelectedValuePath="Value" />
      </StackPanel>
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <TabControl>
      <TabItem Header="{x:Static res:Strings.Tax_RulesTab}">
        <DockPanel Margin="0,12,0,0">
          <ui:InfoBar
              Margin="0,0,0,12"
              DockPanel.Dock="Top"
              IsClosable="False"
              IsOpen="{Binding NoRules}"
              Message="{x:Static res:Strings.Tax_NoRules}"
              Severity="Warning" />
          <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding NewRulesCommand}"
                Content="{x:Static res:Strings.Tax_NewRules}"
                Icon="{ui:SymbolIcon Add20}"
                Visibility="{Binding NoRules, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding NoRules, Converter={StaticResource BoolToVisibility}}">
              <ComboBox
                  Width="240"
                  Margin="0,0,8,0"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding Packs}"
                  SelectedItem="{Binding SelectedPack}"
                  Visibility="{Binding HasPacks, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button
                  Appearance="Primary"
                  Command="{Binding NewFromPackCommand}"
                  Content="{x:Static res:Strings.Tax_FromPack}"
                  Icon="{ui:SymbolIcon DocumentArrowDown20}"
                  Visibility="{Binding HasPacks, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </WrapPanel>
          <TextBlock
              Margin="0,0,0,8"
              DockPanel.Dock="Top"
              Style="{StaticResource Caption}"
              Text="{x:Static res:Strings.Tax_RulesHint}"
              TextWrapping="Wrap" />
          <DataGrid ItemsSource="{Binding RuleSets}" SelectedItem="{Binding SelectedRuleSet, Mode=TwoWay}" Style="{StaticResource ListGrid}">
            <DataGrid.InputBindings>
              <MouseBinding Command="{Binding OpenRulesCommand}" Gesture="LeftDoubleClick" />
              <KeyBinding Key="Enter" Command="{Binding OpenRulesCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" MinWidth="200" Binding="{Binding Name}" Header="{x:Static res:Strings.Tax_RuleName}" />
              <DataGridTextColumn Width="80" Binding="{Binding CountryCode}" Header="{x:Static res:Strings.Tax_Country}" />
              <DataGridTextColumn Width="140" Binding="{Binding EffectiveFrom, StringFormat=MMMM yyyy}" Header="{x:Static res:Strings.Tax_EffectiveFrom}" />
              <DataGridCheckBoxColumn Width="110" Binding="{Binding IsUsed, Mode=OneWay}" Header="{x:Static res:Strings.Tax_Used}" />
              <DataGridTemplateColumn Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <ui:Button
                          Margin="0,0,6,0"
                          Padding="8,2"
                          Command="{Binding DataContext.OpenRulesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.App_Open}" />
                      <ui:Button
                          Padding="8,2"
                          Command="{Binding DataContext.DeleteRulesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.App_Delete}"
                          Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{x:Static res:Strings.Tax_ProfilesTab}">
        <DockPanel Margin="0,12,0,0">
          <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
            <TextBlock
                Margin="0,0,200,0"
                VerticalAlignment="Center"
                Style="{StaticResource Caption}"
                Text="{x:Static res:Strings.Tax_ProfilesHint}"
                TextWrapping="Wrap" />
            <ui:Button
                HorizontalAlignment="Right"
                Appearance="Primary"
                Command="{Binding SaveProfilesCommand}"
                Content="{x:Static res:Strings.App_Save}"
                Icon="{ui:SymbolIcon Save20}"
                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <DataGrid
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"
              ItemsSource="{Binding Profiles}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="80" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" IsReadOnly="True" />
              <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" IsReadOnly="True" />
              <DataGridTemplateColumn Width="140" Header="{x:Static res:Strings.Tax_Category}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding Category}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox
                        IsEditable="True"
                        ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="130" Binding="{Binding Investment, StringFormat=N2}" Header="{x:Static res:Strings.Tax_Investment}" />
              <DataGridTextColumn Width="150" Binding="{Binding PriorIncome, StringFormat=N2}" Header="{x:Static res:Strings.Tax_PriorIncome}" />
              <DataGridTextColumn Width="130" Binding="{Binding PriorTax, StringFormat=N2}" Header="{x:Static res:Strings.Tax_PriorTax}" />
              <DataGridCheckBoxColumn Width="80" Binding="{Binding IsExempt, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static res:Strings.Tax_Exempt}" />
              <DataGridTextColumn Width="160" Binding="{Binding Note}" Header="{x:Static res:Strings.App_Notes}" />
              <DataGridTemplateColumn Width="30" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ui:SymbolIcon Symbol="Edit16" ToolTip="{x:Static res:Strings.Tax_Unsaved}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{x:Static res:Strings.Tax_SummaryTab}">
        <DockPanel Margin="0,12,0,0">
          <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SummaryText}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <ui:Button
                  Margin="0,0,8,0"
                  Command="{Binding ExportStatementCommand}"
                  Content="{x:Static res:Strings.Tax_StatementPdf}"
                  Icon="{ui:SymbolIcon DocumentPdf20}" />
              <ui:Button Command="{Binding ExportSummaryCommand}" Content="{x:Static res:Strings.App_ExportExcel}" Icon="{ui:SymbolIcon ArrowExportUp20}" />
            </StackPanel>
          </Grid>
          <Grid>
            <DataGrid ItemsSource="{Binding SummaryRows}" SelectedItem="{Binding SelectedSummaryRow, Mode=TwoWay}" Style="{StaticResource ListGrid}">
              <DataGrid.Columns>
                <DataGridTextColumn Width="80" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
                <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" />
                <DataGridTextColumn Width="120" Binding="{Binding TaxIdentifier}" Header="{x:Static res:Strings.Tax_TaxId}" />
                <DataGridTextColumn Width="70" Binding="{Binding Months}" Header="{x:Static res:Strings.Tax_Months}" />
                <DataGridTextColumn Width="140" Binding="{Binding Taxable, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Tax_Taxable}" />
                <DataGridTextColumn Width="130" Binding="{Binding Deducted, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Tax_Deducted}" />
                <DataGridTextColumn Width="150" Binding="{Binding LatestAnnualTax, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Tax_AnnualTax}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Text="{x:Static res:Strings.Tax_SummaryEmpty}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding IsSummaryEmpty, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
