<UserControl
    x:Class="SuperOfc.Desktop.Views.Tax.EmployeeTaxTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <ui:InfoBar
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        IsClosable="False"
        IsOpen="True"
        Message="{Binding NoRulesText}"
        Severity="Warning"
        Visibility="{Binding NoRulesText, Converter={StaticResource HasValueToVisibility}}" />
    <ui:Card Margin="0,0,0,12" DockPanel.Dock="Top" Visibility="{Binding ProjectionText, Converter={StaticResource HasValueToVisibility}}">
      <StackPanel>
        <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitle}" Text="{Binding ProjectionTitle}" />
        <TextBlock Margin="0,0,0,8" Style="{StaticResource BodyText}" Text="{Binding ProjectionText}" TextWrapping="Wrap" />
        <Expander Header="{x:Static res:Strings.EmpTax_HowWorkedOut}">
          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Explanation}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,0,0,2" Style="{StaticResource Caption}" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </ui:Card>
    <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}" Text="{Binding TotalsText}" />
      <ui:Button
          HorizontalAlignment="Right"
          Command="{Binding ExportCommand}"
          Content="{x:Static res:Strings.Tax_StatementPdf}"
          Icon="{ui:SymbolIcon DocumentPdf20}"
          Visibility="{Binding HasMonths, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <Grid>
      <DataGrid ItemsSource="{Binding Months}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="*" Binding="{Binding MonthStart, StringFormat=MMMM yyyy}" Header="{x:Static res:Strings.Tax_Month}" />
          <DataGridTextColumn Width="*" Binding="{Binding Taxable, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Tax_Taxable}" />
          <DataGridTextColumn Width="*" Binding="{Binding AnnualTax, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Tax_AnnualTax}" />
          <DataGridTextColumn Width="*" Binding="{Binding Deducted, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Tax_Deducted}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.EmpTax_None}"
          Visibility="{Binding HasMonths, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
