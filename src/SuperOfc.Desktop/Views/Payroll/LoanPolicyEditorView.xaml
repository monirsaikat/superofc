<UserControl
    x:Class="SuperOfc.Desktop.Views.Payroll.LoanPolicyEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Payroll">
  <Grid Margin="0,12,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="24" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <StackPanel>
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.PolicyLoan_DefaultInterest}" />
        <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:LoanPolicyEditor.InterestMethods}" SelectedValue="{Binding DefaultInterestMethod}" SelectedValuePath="Value" />
      </StackPanel>
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.PolicyLoan_Settlement}" />
        <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:LoanPolicyEditor.SettlementChoices}" SelectedValue="{Binding SettlementInterest}" SelectedValuePath="Value" />
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="2">
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.PolicyLoan_SoftLimit}" />
        <ui:NumberBox MaxDecimalPlaces="1" Minimum="0" SpinButtonPlacementMode="Hidden" Value="{Binding SoftLimit}" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.PolicyLoan_SoftLimitHint}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
