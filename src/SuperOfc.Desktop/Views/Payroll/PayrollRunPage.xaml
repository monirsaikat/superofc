<UserControl
    x:Class="SuperOfc.Desktop.Views.Payroll.PayrollRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Payroll">
  <DockPanel Margin="{StaticResource PagePadding}">
    <!-- Header: title, status and the main actions for the current state -->
    <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" />
      </StackPanel>
      <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
        <ui:Button Margin="0,0,8,0" Command="{Binding BackToListCommand}" Content="{x:Static res:Strings.Payroll_AllMonths}" Icon="{ui:SymbolIcon ArrowLeft20}" />
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding ComputeCommand}"
            Content="{x:Static res:Strings.PayrollRun_Compute}"
            Icon="{ui:SymbolIcon Calculator20}"
            Visibility="{Binding CanCompute, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
            Margin="0,0,8,0"
            Appearance="Primary"
            Command="{Binding FinalizeCommand}"
            Content="{x:Static res:Strings.PayrollRun_Finalize}"
            Icon="{ui:SymbolIcon LockClosed20}"
            Visibility="{Binding CanFinalize, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
            Appearance="Danger"
            Command="{Binding VoidCommand}"
            Content="{x:Static res:Strings.PayrollRun_Void}"
            Visibility="{Binding CanVoid, Converter={StaticResource BoolToVisibility}}" />
      </WrapPanel>
    </Grid>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}" Style="{StaticResource StepIndicator}" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <ui:InfoBar
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        IsClosable="True"
        IsOpen="True"
        Message="{Binding ComputeText}"
        Severity="Success"
        Title="{x:Static res:Strings.PayrollRun_ComputedTitle}"
        Visibility="{Binding ComputeText, Converter={StaticResource HasValueToVisibility}}" />

    <!-- Totals -->
    <UniformGrid Margin="0,0,0,12" Columns="4" DockPanel.Dock="Top" Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
      <ui:Card Margin="0,0,8,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.Payroll_Employees}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Run.Payslips.Count}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,8,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.Payroll_Gross}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Run.Gross, Converter={StaticResource Money}}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,8,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.Payroll_Deductions}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Run.Deductions, Converter={StaticResource Money}}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.Payroll_Net}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Run.Net, Converter={StaticResource Money}}" />
        </StackPanel>
      </ui:Card>
    </UniformGrid>

    <!-- Right column: readiness, adjustments and payslip preview -->
    <ScrollViewer
        Width="400"
        Margin="16,0,0,0"
        DockPanel.Dock="Right"
        VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}" Visibility="{Binding IsFinalized, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.PayrollRun_Readiness}" />
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding ReadinessText}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.PayrollRun_Adjustments}" />
              <ui:Button
                  Padding="8,2"
                  HorizontalAlignment="Right"
                  Command="{Binding StartAdjustmentCommand}"
                  Content="{x:Static res:Strings.PayrollRun_AddAdjustment}"
                  Icon="{ui:SymbolIcon Add16}"
                  Visibility="{Binding CanEditAdjustments, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Caption}" Text="{x:Static res:Strings.PayrollRun_AdjustmentsHint}" TextWrapping="Wrap" />
            <StackPanel Margin="0,0,0,8" Visibility="{Binding IsAddingAdjustment, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_Employee}" />
                <ComboBox
                    DisplayMemberPath="Name"
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    ItemsSource="{Binding Employees}"
                    SelectedValue="{Binding NewAdjEmployeeId}"
                    SelectedValuePath="Id"
                    TextSearch.TextPath="Name" />
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.PayrollRun_AdjustmentName}" />
                  <ui:TextBox PlaceholderText="{x:Static res:Strings.PayrollRun_AdjustmentNameHint}" Text="{Binding NewAdjName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.SalaryComponents_Kind}" />
                  <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:PayrollRunViewModel.AdjustmentKinds}" SelectedValue="{Binding NewAdjKind}" SelectedValuePath="Value" />
                </StackPanel>
              </Grid>
              <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.PayrollRun_Amount}" />
                <ui:NumberBox MaxDecimalPlaces="2" Minimum="0" SpinButtonPlacementMode="Hidden" Value="{Binding NewAdjAmount}" />
              </StackPanel>
              <CheckBox Margin="0,0,0,8" Content="{x:Static res:Strings.SalaryComponents_Taxable}" IsChecked="{Binding NewAdjTaxable}" />
              <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_Reason}" />
                <ui:TextBox Text="{Binding NewAdjReason, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveAdjustmentCommand}" Content="{x:Static res:Strings.App_Save}" />
                <ui:Button Command="{Binding CancelAdjustmentCommand}" Content="{x:Static res:Strings.App_Cancel}" />
              </StackPanel>
            </StackPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Adjustments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding EmployeeName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Kind, Mode=OneWay, Converter={StaticResource EnumText}, ConverterParameter=ComponentKind}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding Amount, Converter={StaticResource Money}, ConverterParameter=plain}" />
                    <ui:Button
                        Grid.Column="2"
                        Padding="4"
                        Appearance="Transparent"
                        Command="{Binding DataContext.DeleteAdjustmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Icon="{ui:SymbolIcon Delete16}"
                        ToolTip="{x:Static res:Strings.App_Delete}"
                        Visibility="{Binding DataContext.CanEditAdjustments, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <ui:Card Padding="8" Visibility="{Binding PreviewImage, Converter={StaticResource HasValueToVisibility}}">
          <StackPanel>
            <TextBlock Margin="4,0,0,6" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.PayrollRun_Preview}" />
            <Border Background="White" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding PreviewImage, Converter={StaticResource PngBytes}}" Stretch="Uniform" />
            </Border>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <!-- Payment and export actions (finalized runs) -->
    <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
      <ui:TextBox
          Width="220"
          Margin="0,0,8,8"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.Attendance_SearchHint}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
          Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}" />
      <StackPanel Orientation="Horizontal" Visibility="{Binding CanPay, Converter={StaticResource BoolToVisibility}}">
        <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding MarkPaidCommand}" Content="{x:Static res:Strings.PayrollRun_MarkPaid}" Icon="{ui:SymbolIcon Checkmark20}" />
        <ui:Button Margin="0,0,8,8" Command="{Binding MarkUnpaidCommand}" Content="{x:Static res:Strings.PayrollRun_MarkUnpaid}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
        <ui:DropDownButton Margin="0,0,8,8" Content="{x:Static res:Strings.PayrollRun_Payslips}" Icon="{ui:SymbolIcon DocumentPdf20}">
          <ui:DropDownButton.Flyout>
            <ContextMenu>
              <MenuItem Command="{Binding ExportPdfCommand}" CommandParameter="merged" Header="{x:Static res:Strings.PayrollRun_PdfMerged}" />
              <MenuItem Command="{Binding ExportPdfCommand}" CommandParameter="split" Header="{x:Static res:Strings.PayrollRun_PdfSplit}" />
            </ContextMenu>
          </ui:DropDownButton.Flyout>
        </ui:DropDownButton>
        <ui:Button Margin="0,0,8,8" Command="{Binding ExportSheetCommand}" CommandParameter="Bank" Content="{x:Static res:Strings.PayrollRun_BankSheet}" Icon="{ui:SymbolIcon BuildingBank20}" />
        <ui:Button Margin="0,0,8,8" Command="{Binding ExportSheetCommand}" CommandParameter="Cash" Content="{x:Static res:Strings.PayrollRun_CashSheet}" Icon="{ui:SymbolIcon Money20}" />
        <ui:Button Margin="0,0,8,8" Command="{Binding RegisterCommand}" Content="{x:Static res:Strings.Register_Title}" Icon="{ui:SymbolIcon Table20}" />
      </StackPanel>
      <TextBlock Margin="0,0,0,8" VerticalAlignment="Center" Style="{StaticResource Caption}" Visibility="{Binding CheckedCount, Converter={StaticResource HasValueToVisibility}}">
        <Run Text="{Binding CheckedCount, Mode=OneWay}" />
        <Run Text="{x:Static res:Strings.PayrollRun_CheckedHint}" />
      </TextBlock>
    </WrapPanel>

    <Grid>
      <DataGrid ItemsSource="{Binding Payslips}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="40">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="80" Binding="{Binding Row.EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
          <DataGridTextColumn Width="*" MinWidth="140" Binding="{Binding Row.EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" />
          <DataGridTextColumn Width="120" Binding="{Binding Row.Department}" Header="{x:Static res:Strings.Employees_Department}" />
          <DataGridTextColumn Width="70" Binding="{Binding Row.PayableDays, StringFormat=0.##}" Header="{x:Static res:Strings.Payroll_Days}" />
          <DataGridTextColumn Width="120" Binding="{Binding Row.Gross, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Payroll_Gross}" />
          <DataGridTextColumn Width="110" Binding="{Binding Row.Deductions, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Payroll_Deductions}" />
          <DataGridTextColumn Width="120" Binding="{Binding Row.Net, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Payroll_Net}" />
          <DataGridTemplateColumn Width="90" Header="{x:Static res:Strings.Payroll_Payment}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border HorizontalAlignment="Left" Background="{Binding Row.PaymentStatus, Converter={StaticResource PayrollBrush}}" Style="{StaticResource Badge}">
                  <TextBlock Foreground="White" Text="{Binding Row.PaymentStatus, Converter={StaticResource EnumText}, ConverterParameter=PaymentStatus}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ui:SymbolIcon
                    Foreground="{StaticResource StatusLateBrush}"
                    Symbol="Warning16"
                    ToolTip="{Binding Row.Warnings}"
                    Visibility="{Binding Row.HasWarnings, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          MaxWidth="460"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.PayrollRun_Empty}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="{Binding HasRun, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
