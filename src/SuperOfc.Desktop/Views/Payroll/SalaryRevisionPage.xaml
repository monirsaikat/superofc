<UserControl
    x:Class="SuperOfc.Desktop.Views.Payroll.SalaryRevisionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <DockPanel Margin="{StaticResource PagePadding}">
    <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}" Style="{StaticResource StepIndicator}" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <!-- Footer buttons -->
    <Grid Margin="0,12,0,0" DockPanel.Dock="Bottom">
      <ui:Button Command="{Binding BackCommand}" Content="{x:Static res:Strings.App_Back}" Visibility="{Binding IsChoosing, Converter={StaticResource InverseBoolToVisibility}}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
            Appearance="Primary"
            Command="{Binding NextCommand}"
            Content="{x:Static res:Strings.App_Next}"
            Visibility="{Binding IsReviewing, Converter={StaticResource InverseBoolToVisibility}}" />
        <ui:Button
            Appearance="Primary"
            Command="{Binding ApplyCommand}"
            Content="{x:Static res:Strings.Revision_Apply}"
            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>

    <Grid>
      <!-- Step 1: employees -->
      <DockPanel Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibility}}">
        <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
          <ui:TextBox
              Width="260"
              HorizontalAlignment="Left"
              Icon="{ui:SymbolIcon Search20}"
              PlaceholderText="{x:Static res:Strings.Revision_SearchHint}"
              Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Caption}">
              <Run Text="{Binding SelectedCount, Mode=OneWay}" />
              <Run Text="{x:Static res:Strings.Revision_Selected}" />
            </TextBlock>
            <ui:Button Margin="0,0,8,0" Command="{Binding SelectAllCommand}" Content="{x:Static res:Strings.App_SelectAll}">
              <ui:Button.CommandParameter>
                <sys:Boolean>True</sys:Boolean>
              </ui:Button.CommandParameter>
            </ui:Button>
            <ui:Button Command="{Binding SelectAllCommand}" Content="{x:Static res:Strings.App_SelectNone}">
              <ui:Button.CommandParameter>
                <sys:Boolean>False</sys:Boolean>
              </ui:Button.CommandParameter>
            </ui:Button>
          </StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding Candidates}" Style="{StaticResource ListGrid}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Width="90" Binding="{Binding Employee.Code}" Header="{x:Static res:Strings.Employees_Code}" />
            <DataGridTextColumn Width="*" Binding="{Binding Employee.FullName}" Header="{x:Static res:Strings.Employees_Name}" />
            <DataGridTextColumn Width="180" Binding="{Binding Employee.Department}" Header="{x:Static res:Strings.Employees_Department}" />
            <DataGridTextColumn Width="180" Binding="{Binding Employee.Designation}" Header="{x:Static res:Strings.Employees_Designation}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- Step 2: change -->
      <StackPanel MaxWidth="480" HorizontalAlignment="Left" Visibility="{Binding IsSetting, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Revision_Percent}" />
            <ui:NumberBox MaxDecimalPlaces="2" Maximum="500" Minimum="-50" SpinButtonPlacementMode="Hidden" Value="{Binding Percent}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Salary_EffectiveFrom}" />
            <DatePicker SelectedDate="{Binding EffectiveFrom}" />
          </StackPanel>
        </Grid>
        <CheckBox Margin="0,0,0,4" Content="{x:Static res:Strings.Revision_AllFixed}" IsChecked="{Binding AllFixedEarnings}" />
        <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Revision_AllFixedHint}" TextWrapping="Wrap" />
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Salary_Note}" />
          <ui:TextBox PlaceholderText="{x:Static res:Strings.Revision_NoteHint}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>

      <!-- Step 3: review -->
      <DockPanel Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource BodyText}" Text="{Binding Summary}" TextWrapping="Wrap" />
        <DataGrid ItemsSource="{Binding Preview}" Style="{StaticResource ListGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="90" Binding="{Binding Code}" Header="{x:Static res:Strings.Employees_Code}" />
            <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="{x:Static res:Strings.Employees_Name}" />
            <DataGridTextColumn Width="120" Binding="{Binding CurrentBasic, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Revision_CurrentBasic}" />
            <DataGridTextColumn Width="120" Binding="{Binding NewBasic, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Revision_NewBasic}" />
            <DataGridTextColumn Width="120" Binding="{Binding CurrentGross, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Revision_CurrentGross}" />
            <DataGridTextColumn Width="120" Binding="{Binding NewGross, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Revision_NewGross}" />
            <DataGridTextColumn Width="220" Binding="{Binding Problem}" Header="{x:Static res:Strings.Revision_Problem}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
