<UserControl
    x:Class="SuperOfc.Desktop.Views.Payroll.SalaryStructuresSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mvvm="clr-namespace:SuperOfc.Desktop.Mvvm"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding NewCommand}"
          Content="{x:Static res:Strings.SalaryStructures_New}"
          Icon="{ui:SymbolIcon Add20}"
          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{x:Static res:Strings.SalaryStructures_Intro}" TextWrapping="Wrap" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <DataGrid
        MaxHeight="220"
        Margin="0,0,0,16"
        DockPanel.Dock="Top"
        ItemsSource="{Binding Structures}"
        SelectedItem="{Binding Selected, Mode=TwoWay}"
        Style="{StaticResource ListGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="200" Binding="{Binding Name}" Header="{x:Static res:Strings.SalaryStructures_Name}" />
        <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{x:Static res:Strings.SalaryStructures_Description}" />
        <DataGridTextColumn Width="100" Binding="{Binding Lines.Count}" Header="{x:Static res:Strings.SalaryStructures_Components}" />
      </DataGrid.Columns>
    </DataGrid>

    <ui:Card Padding="{StaticResource CardPadding}" VerticalAlignment="Top" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.SalaryStructures_Name}" />
            <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.SalaryStructures_Description}" />
            <ui:TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,0,0,8" Style="{StaticResource Caption}" Text="{x:Static res:Strings.SalaryStructures_SampleHint}" TextWrapping="Wrap" />
        <ContentControl
            Margin="{StaticResource FieldMargin}"
            Content="{Binding Editor}"
            ContentTemplateSelector="{x:Static mvvm:ViewLocator.Instance}"
            Focusable="False" />
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding CancelEditCommand}" Content="{x:Static res:Strings.App_Cancel}" />
          <ui:Button
              Appearance="Danger"
              Command="{Binding DeleteCommand}"
              Content="{x:Static res:Strings.App_Delete}"
              Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>
  </DockPanel>
</UserControl>
