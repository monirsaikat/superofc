<UserControl
    x:Class="SuperOfc.Desktop.Views.Letters.LettersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <DockPanel Margin="{StaticResource PagePadding}">
    <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
    <TabControl SelectedIndex="{Binding Tab}">
      <TabItem Header="{x:Static res:Strings.Letters_IssueTab}">
        <DockPanel Margin="0,12,0,0">
          <TextBlock
              Margin="0,0,0,8"
              DockPanel.Dock="Top"
              Style="{StaticResource ErrorText}"
              Text="{Binding ErrorMessage}"
              TextWrapping="Wrap"
              Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

          <!-- Who -->
          <DockPanel Width="330" Margin="0,0,16,0" DockPanel.Dock="Left">
            <TextBlock Margin="0,0,0,4" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Letters_Who}" />
            <ComboBox
                Margin="0,0,0,6"
                DisplayMemberPath="Name"
                DockPanel.Dock="Top"
                ItemsSource="{Binding Departments}"
                SelectedValue="{Binding DepartmentId}"
                SelectedValuePath="Id" />
            <ui:TextBox
                Margin="0,0,0,6"
                DockPanel.Dock="Top"
                Icon="{ui:SymbolIcon Search20}"
                PlaceholderText="{x:Static res:Strings.Employees_SearchHint}"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="0,0,0,6" Content="{x:Static res:Strings.Letters_IncludeLeft}" DockPanel.Dock="Top" IsChecked="{Binding IncludeLeft}" />
            <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SelectionText}" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Margin="0,0,4,0" Padding="8,2" Command="{Binding SelectAllCommand}" Content="{x:Static res:Strings.App_SelectAll}">
                  <ui:Button.CommandParameter>
                    <sys:Boolean>True</sys:Boolean>
                  </ui:Button.CommandParameter>
                </ui:Button>
                <ui:Button Padding="8,2" Command="{Binding SelectAllCommand}" Content="{x:Static res:Strings.App_SelectNone}">
                  <ui:Button.CommandParameter>
                    <sys:Boolean>False</sys:Boolean>
                  </ui:Button.CommandParameter>
                </ui:Button>
              </StackPanel>
            </Grid>
            <ListBox ItemsSource="{Binding People}" VirtualizingPanel.IsVirtualizing="True">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}">
                    <TextBlock>
                      <Run Text="{Binding Employee.Code, Mode=OneWay}" />
                      <Run Text="·" />
                      <Run Text="{Binding Employee.FullName, Mode=OneWay}" />
                    </TextBlock>
                  </CheckBox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- What -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Letters_What}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Letters_Template}" />
                  <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Letters_Date}" />
                  <DatePicker SelectedDate="{Binding Date}" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding Inputs}" Visibility="{Binding HasInputs, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Style="{StaticResource Field}">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Name}" />
                      <ui:TextBox AcceptsReturn="True" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=400}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsWordTemplate, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Letters_SaveAs}" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton
                      Margin="0,0,16,0"
                      Content="{x:Static res:Strings.Letters_OutputPdf}"
                      GroupName="LetterOutput"
                      IsChecked="{Binding Output, Converter={StaticResource Equals}, ConverterParameter=Pdf}"
                      IsEnabled="{Binding WordInstalled}" />
                  <RadioButton Content="{x:Static res:Strings.Letters_OutputWord}" GroupName="LetterOutput" IsChecked="{Binding Output, Converter={StaticResource Equals}, ConverterParameter=Word}" />
                </StackPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Caption}"
                    Text="{x:Static res:Strings.Letters_PdfNeedsWord}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowPdfNeedsWord, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <CheckBox
                  Margin="0,0,0,4"
                  Content="{Binding OnePerEmployeeText}"
                  IsChecked="{Binding PerEmployeeChecked}"
                  IsEnabled="{Binding PerEmployeeEnabled}" />
              <TextBlock
                  Margin="0,0,0,4"
                  Style="{StaticResource Caption}"
                  Text="{x:Static res:Strings.Letters_WordOnePerPerson}"
                  TextWrapping="Wrap"
                  Visibility="{Binding PerEmployeeForced, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Margin="0,6,0,16" Orientation="Horizontal" Visibility="{Binding CanIssue, Converter={StaticResource BoolToVisibility}}">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding IssueCommand}"
                    Content="{Binding IssueText}"
                    Icon="{ui:SymbolIcon Print20}" />
                <ui:Button
                    Command="{Binding OpenSampleCommand}"
                    Content="{x:Static res:Strings.LetterTemplates_OpenSample}"
                    Icon="{ui:SymbolIcon Open20}"
                    Visibility="{Binding IsWordTemplate, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <TextBlock Margin="0,0,0,6" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.LetterTemplates_Preview}" />
              <ui:Card>
                <StackPanel>
                  <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding PreviewSubject}" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource BodyText}" Text="{Binding PreviewBody}" TextWrapping="Wrap" />
                </StackPanel>
              </ui:Card>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="{x:Static res:Strings.Letters_RegisterTab}">
        <DockPanel Margin="0,12,0,0">
          <ui:TextBox
              Width="300"
              Margin="0,0,0,8"
              HorizontalAlignment="Left"
              DockPanel.Dock="Top"
              Icon="{ui:SymbolIcon Search20}"
              PlaceholderText="{x:Static res:Strings.Letters_RegisterSearch}"
              Text="{Binding RegisterSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
          <Grid>
            <DataGrid ItemsSource="{Binding Issued}" SelectedItem="{Binding SelectedIssued, Mode=TwoWay}" Style="{StaticResource ListGrid}">
              <DataGrid.Columns>
                <DataGridTextColumn Width="130" Binding="{Binding Number}" Header="{x:Static res:Strings.Letters_Number}" />
                <DataGridTextColumn Width="110" Binding="{Binding IssuedOn, StringFormat=dd MMM yyyy}" Header="{x:Static res:Strings.Letters_Date}" />
                <DataGridTextColumn Width="80" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
                <DataGridTextColumn Width="*" MinWidth="150" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" />
                <DataGridTextColumn Width="*" MinWidth="150" Binding="{Binding TemplateName}" Header="{x:Static res:Strings.Letters_Template}" />
                <DataGridTemplateColumn Width="60">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock
                          VerticalAlignment="Center"
                          Style="{StaticResource Caption}"
                          Text="{x:Static res:Strings.LetterTemplates_WordMarker}"
                          ToolTip="{x:Static res:Strings.Letters_OutputWord}"
                          Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="120" Binding="{Binding IssuedBy}" Header="{x:Static res:Strings.Letters_IssuedBy}" />
                <DataGridTemplateColumn Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ui:Button
                          Padding="8,2"
                          Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.Letters_Reprint}"
                          Visibility="{Binding DataContext.CanIssue, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Text="{x:Static res:Strings.Letters_RegisterEmpty}"
                Visibility="{Binding IsRegisterEmpty, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
