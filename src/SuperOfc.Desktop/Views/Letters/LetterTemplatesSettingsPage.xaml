<UserControl
    x:Class="SuperOfc.Desktop.Views.Letters.LetterTemplatesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Letters">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
        <ui:Button Margin="0,0,8,0" Command="{Binding AddStandardCommand}" Content="{x:Static res:Strings.LetterTemplates_AddStandard}" Icon="{ui:SymbolIcon DocumentCopy20}" />
        <ui:Button Appearance="Primary" Command="{Binding NewCommand}" Content="{x:Static res:Strings.LetterTemplates_New}" Icon="{ui:SymbolIcon Add20}" />
      </StackPanel>
    </Grid>
    <TextBlock
        Margin="0,0,0,8"
        DockPanel.Dock="Top"
        Style="{StaticResource Caption}"
        Text="{x:Static res:Strings.LetterTemplates_Hint}"
        TextWrapping="Wrap" />
    <TextBlock
        Margin="0,0,0,8"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <!-- Template list -->
    <ListBox
        Width="210"
        Margin="0,0,16,0"
        DisplayMemberPath="Name"
        DockPanel.Dock="Left"
        ItemsSource="{Binding Templates}"
        SelectedItem="{Binding Selected}" />

    <!-- Fields to insert -->
    <DockPanel Width="250" Margin="16,0,0,0" DockPanel.Dock="Right">
      <TextBlock Margin="0,0,0,4" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LetterTemplates_Fields}" />
      <ui:TextBox
          Margin="0,0,0,6"
          DockPanel.Dock="Top"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.App_Search}"
          Text="{Binding FieldSearch, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,0,0,6" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{x:Static res:Strings.LetterTemplates_FieldsHint}" TextWrapping="Wrap" />
      <ListBox x:Name="FieldList" ItemsSource="{Binding Fields}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel ToolTip="{Binding Token}">
              <TextBlock FontFamily="Consolas" Text="{Binding Token}" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.InputBindings>
          <MouseBinding Command="{Binding InsertCommand}" CommandParameter="{Binding SelectedItem, ElementName=FieldList}" Gesture="LeftDoubleClick" />
          <KeyBinding Key="Enter" Command="{Binding InsertCommand}" CommandParameter="{Binding SelectedItem, ElementName=FieldList}" />
        </ListBox.InputBindings>
      </ListBox>
    </DockPanel>

    <!-- Editor and preview -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Tax_RuleName}" />
            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.TaxRules_Kind}" />
            <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:LetterTemplatesSettingsViewModel.Kinds}" SelectedValue="{Binding Kind}" SelectedValuePath="Value" />
          </StackPanel>
          <StackPanel Grid.Column="4" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LetterTemplates_Prefix}" />
            <ui:TextBox MaxLength="20" Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
          </StackPanel>
        </Grid>
        <CheckBox Margin="0,0,0,8" Content="{x:Static res:Strings.LetterTemplates_Active}" IsChecked="{Binding IsActive}" />
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LetterTemplates_Subject}" />
          <TextBox x:Name="SubjectBox" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LetterTemplates_Body}" />
          <TextBox
              x:Name="BodyBox"
              MinHeight="260"
              MaxHeight="420"
              AcceptsReturn="True"
              FontFamily="Consolas"
              Text="{Binding Body, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
              TextWrapping="Wrap"
              VerticalScrollBarVisibility="Auto" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.LetterTemplates_FormatHint}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Margin="0,4,0,16" Orientation="Horizontal" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Command="{Binding DeleteCommand}" Content="{x:Static res:Strings.App_Delete}" Visibility="{Binding EditingId, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>

        <Grid Margin="0,0,0,6">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.LetterTemplates_Preview}" />
          <ComboBox
              Width="240"
              HorizontalAlignment="Right"
              DisplayMemberPath="Name"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding Employees}"
              SelectedValue="{Binding SampleEmployeeId}"
              SelectedValuePath="Id"
              TextSearch.TextPath="Name"
              ToolTip="{x:Static res:Strings.LetterTemplates_SampleEmployee}" />
        </Grid>
        <TextBlock
            Margin="0,0,0,6"
            Style="{StaticResource ErrorText}"
            Text="{Binding PreviewMissing}"
            TextWrapping="Wrap"
            Visibility="{Binding PreviewMissing, Converter={StaticResource HasValueToVisibility}}" />
        <ui:Card>
          <StackPanel>
            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding PreviewSubject}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding PreviewBody}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
