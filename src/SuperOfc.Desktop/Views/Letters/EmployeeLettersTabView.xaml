<UserControl
    x:Class="SuperOfc.Desktop.Views.Letters.EmployeeLettersTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding NewCommand}"
          Content="{x:Static res:Strings.Letters_New}"
          Icon="{ui:SymbolIcon DocumentAdd20}"
          Visibility="{Binding CanIssue, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <Grid>
      <DataGrid ItemsSource="{Binding Letters}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="130" Binding="{Binding Number}" Header="{x:Static res:Strings.Letters_Number}" />
          <DataGridTextColumn Width="110" Binding="{Binding IssuedOn, StringFormat=dd MMM yyyy}" Header="{x:Static res:Strings.Letters_Date}" />
          <DataGridTextColumn Width="*" Binding="{Binding TemplateName}" Header="{x:Static res:Strings.Letters_Template}" />
          <DataGridTemplateColumn Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="{x:Static res:Strings.LetterTemplates_WordMarker}"
                    ToolTip="{x:Static res:Strings.Letters_OutputWord}"
                    Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="120" Binding="{Binding IssuedBy}" Header="{x:Static res:Strings.Letters_IssuedBy}" />
          <DataGridTemplateColumn Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ui:Button
                    Padding="8,2"
                    Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"
                    Content="{x:Static res:Strings.Letters_Reprint}"
                    Visibility="{Binding DataContext.CanIssue, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.EmpLetters_None}"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
