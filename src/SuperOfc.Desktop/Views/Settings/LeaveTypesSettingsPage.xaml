<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.LeaveTypesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Settings">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding NewCommand}"
          Content="{x:Static res:Strings.LeaveTypes_New}"
          Icon="{ui:SymbolIcon Add20}"
          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <ui:Card
        Width="340"
        Margin="16,0,0,0"
        Padding="{StaticResource CardPadding}"
        VerticalAlignment="Top"
        DockPanel.Dock="Right"
        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LeaveTypes_Name}" />
            <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LeaveTypes_Code}" />
            <ui:TextBox CharacterCasing="Upper" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LeaveTypes_Entitlement}" />
            <ui:NumberBox MaxDecimalPlaces="1" Minimum="0" SmallChange="0.5" SpinButtonPlacementMode="Hidden" Value="{Binding EditEntitlement}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LeaveTypes_Accrual}" />
            <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:LeaveTypesSettingsViewModel.Accruals}" SelectedValue="{Binding EditAccrual}" SelectedValuePath="Value" />
          </StackPanel>
        </Grid>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.LeaveTypes_CarryCap}" />
          <ui:NumberBox MaxDecimalPlaces="1" Minimum="0" SpinButtonPlacementMode="Hidden" Value="{Binding EditCarryCap}" />
        </StackPanel>
        <CheckBox Margin="0,0,0,6" Content="{x:Static res:Strings.LeaveTypes_Paid}" IsChecked="{Binding EditPaid}" />
        <CheckBox Margin="0,0,0,6" Content="{x:Static res:Strings.LeaveTypes_HalfDay}" IsChecked="{Binding EditHalfDay}" />
        <CheckBox Margin="0,0,0,6" Content="{x:Static res:Strings.LeaveTypes_Attachment}" IsChecked="{Binding EditAttachment}" />
        <CheckBox Margin="{StaticResource FieldMargin}" Content="{x:Static res:Strings.LeaveTypes_Negative}" IsChecked="{Binding EditNegative}" />
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding CancelEditCommand}" Content="{x:Static res:Strings.App_Cancel}" />
          <ui:Button Appearance="Danger" Command="{Binding DeleteCommand}" Content="{x:Static res:Strings.App_Delete}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <DataGrid ItemsSource="{Binding Types}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="{x:Static res:Strings.LeaveTypes_Name}" />
        <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="{x:Static res:Strings.LeaveTypes_Code}" />
        <DataGridTextColumn Width="110" Binding="{Binding YearlyEntitlement, StringFormat=0.#}" Header="{x:Static res:Strings.LeaveTypes_Entitlement}" />
        <DataGridTextColumn Width="150" Binding="{Binding Accrual, Converter={StaticResource EnumText}, ConverterParameter=Accrual}" Header="{x:Static res:Strings.LeaveTypes_Accrual}" />
        <DataGridCheckBoxColumn Width="60" Binding="{Binding IsPaid}" Header="{x:Static res:Strings.LeaveTypes_Paid}" />
        <DataGridTextColumn Width="110" Binding="{Binding CarryForwardCap, StringFormat=0.#}" Header="{x:Static res:Strings.LeaveTypes_CarryCap}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
