<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.AuditLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
    <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top">
      <ui:TextBox
          Width="260"
          Margin="0,0,8,0"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.App_Search}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox Width="160" Margin="0,0,8,0" ItemsSource="{Binding Users}" SelectedItem="{Binding UserName}" ToolTip="{x:Static res:Strings.Audit_User}" />
      <DatePicker Width="140" Margin="0,0,8,0" SelectedDate="{Binding From}" ToolTip="{x:Static res:Strings.Audit_From}" />
      <DatePicker Width="140" SelectedDate="{Binding To}" ToolTip="{x:Static res:Strings.Audit_To}" />
    </WrapPanel>
    <Grid Margin="0,8,0,0" DockPanel.Dock="Bottom">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding PageText}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Command="{Binding PreviousPageCommand}" Content="{x:Static res:Strings.Employees_Previous}" />
        <ui:Button Command="{Binding NextPageCommand}" Content="{x:Static res:Strings.Employees_NextPage}" />
      </StackPanel>
    </Grid>
    <Grid Height="180" Margin="0,8,0,0" DockPanel.Dock="Bottom" Visibility="{Binding Selected, Converter={StaticResource HasValueToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="12" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Audit_Before}" />
        <TextBox FontFamily="Consolas" IsReadOnly="True" Text="{Binding Selected.BeforeJson, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Audit_After}" />
        <TextBox FontFamily="Consolas" IsReadOnly="True" Text="{Binding Selected.AfterJson, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      </DockPanel>
    </Grid>
    <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="150" Binding="{Binding AtUtc, StringFormat=g, Converter={StaticResource LocalTime}}" Header="{x:Static res:Strings.Audit_When}" />
        <DataGridTextColumn Width="110" Binding="{Binding UserName}" Header="{x:Static res:Strings.Audit_User}" />
        <DataGridTextColumn Width="160" Binding="{Binding Action}" Header="{x:Static res:Strings.Audit_Action}" />
        <DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="{x:Static res:Strings.Audit_Summary}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
