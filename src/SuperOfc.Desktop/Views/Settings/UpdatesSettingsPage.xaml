<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.UpdatesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Updates_Current}" />
          <TextBlock Margin="0,0,0,12" Style="{StaticResource BodyText}" Text="{Binding CurrentVersion}" />
          <TextBlock Margin="0,0,0,12" Style="{StaticResource BodyText}" Text="{Binding StatusText}" />
          <ProgressBar
              Height="4"
              Margin="0,0,0,12"
              Maximum="100"
              Value="{Binding Progress}"
              Visibility="{Binding Progress, Converter={StaticResource HasValueToVisibility}}" />
          <StackPanel Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding CheckCommand}"
                Content="{x:Static res:Strings.Updates_Check}"
                Icon="{ui:SymbolIcon ArrowSync20}"
                IsEnabled="{Binding IsInstalled}" />
            <ui:Button
                Appearance="Primary"
                Command="{Binding RestartCommand}"
                Content="{x:Static res:Strings.Updates_Restart}"
                Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="{StaticResource CardPadding}" IsEnabled="{Binding IsAdmin}">
        <StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Updates_Mode}" />
            <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:UpdatesSettingsViewModel.Modes}" SelectedValue="{Binding Mode}" SelectedValuePath="Value" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Updates_Channel}" />
            <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:UpdatesSettingsViewModel.Channels}" SelectedValue="{Binding Channel}" SelectedValuePath="Value" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Updates_FeedUrl}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Text="{Binding FeedUrl, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SaveFeedCommand}" Content="{x:Static res:Strings.App_Save}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
