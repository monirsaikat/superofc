<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.BackupSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Backup_Description}" />
      <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
        <ui:Button
            Margin="0,0,8,0"
            Appearance="Primary"
            Command="{Binding BackupNowCommand}"
            Content="{x:Static res:Strings.Backup_Now}"
            Icon="{ui:SymbolIcon CloudArrowUp20}" />
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding RestoreFromFileCommand}"
            Content="{x:Static res:Strings.Backup_Restore}"
            Icon="{ui:SymbolIcon ArrowReset20}"
            Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button Command="{Binding OpenFolderCommand}" Content="{x:Static res:Strings.Backup_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen20}" />
      </StackPanel>
      <TextBlock
          Margin="0,0,0,12"
          Style="{StaticResource ErrorText}"
          Text="{Binding ErrorMessage}"
          Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
      <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Backup_History}" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="160" Binding="{Binding CreatedText}" Header="{x:Static res:Strings.Backup_Created_At}" />
        <DataGridTextColumn Width="110" Binding="{Binding Type, Converter={StaticResource EnumText}, ConverterParameter=BackupType}" Header="{x:Static res:Strings.Backup_Type}" />
        <DataGridTextColumn Width="90" Binding="{Binding SizeText}" Header="{x:Static res:Strings.Backup_Size}" />
        <DataGridTextColumn Width="*" Binding="{Binding FileName}" Header="{x:Static res:Strings.Backup_File}" />
        <DataGridTemplateColumn Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ui:Button
                  Padding="8,2"
                  Appearance="Transparent"
                  Command="{Binding DataContext.RestoreSelectedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  CommandParameter="{Binding}"
                  Content="{x:Static res:Strings.Backup_Restore}"
                  Visibility="{Binding DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
