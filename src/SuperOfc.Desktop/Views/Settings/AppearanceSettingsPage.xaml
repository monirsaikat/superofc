<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_Theme}" />
          <ComboBox DisplayMemberPath="Text" ItemsSource="{x:Static vm:AppearanceSettingsViewModel.Themes}" SelectedValue="{Binding Theme}" SelectedValuePath="Value" />
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="{StaticResource CardPadding}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Users_ChangeMyPassword}" />
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Users_CurrentPassword}" />
            <ui:PasswordBox Password="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Users_NewPassword}" />
            <ui:PasswordBox Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Setup_PasswordHint}" />
          </StackPanel>
          <TextBlock
              Margin="0,0,0,12"
              Style="{StaticResource ErrorText}"
              Text="{Binding ErrorMessage}"
              Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
          <ui:Button HorizontalAlignment="Left" Appearance="Primary" Command="{Binding ChangePasswordCommand}" Content="{x:Static res:Strings.App_Save}" />
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
