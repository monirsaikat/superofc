<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.HolidaysSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
        <ComboBox
            Width="110"
            Margin="16,0,0,0"
            ItemsSource="{Binding Years}"
            SelectedItem="{Binding Year}" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding CopyPreviousCommand}"
            Content="{x:Static res:Strings.Holidays_CopyPrevious}"
            Icon="{ui:SymbolIcon Copy20}" />
        <ui:Button
            Appearance="Primary"
            Command="{Binding NewCommand}"
            Content="{x:Static res:Strings.Holidays_New}"
            Icon="{ui:SymbolIcon Add20}" />
      </StackPanel>
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <ui:Card
        Width="320"
        Margin="16,0,0,0"
        Padding="{StaticResource CardPadding}"
        VerticalAlignment="Top"
        DockPanel.Dock="Right"
        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Holidays_Date}" />
          <DatePicker SelectedDate="{Binding EditDate}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Holidays_Name}" />
          <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Holidays_Location}" />
          <ComboBox
              DisplayMemberPath="Name"
              ItemsSource="{Binding Locations}"
              SelectedValue="{Binding EditLocationId}"
              SelectedValuePath="Id" />
        </StackPanel>
        <CheckBox Margin="{StaticResource FieldMargin}" Content="{x:Static res:Strings.Holidays_Paid}" IsChecked="{Binding EditPaid}" />
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding CancelEditCommand}" Content="{x:Static res:Strings.App_Cancel}" />
          <ui:Button Appearance="Danger" Command="{Binding DeleteCommand}" Content="{x:Static res:Strings.App_Delete}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <DataGrid ItemsSource="{Binding Holidays}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="130" Binding="{Binding Date, StringFormat=ddd d MMM}" Header="{x:Static res:Strings.Holidays_Date}" />
        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="{x:Static res:Strings.Holidays_Name}" />
        <DataGridCheckBoxColumn Width="70" Binding="{Binding IsPaid}" Header="{x:Static res:Strings.Holidays_Paid}" />
        <DataGridTextColumn Width="160" Binding="{Binding LocationName, TargetNullValue={x:Static res:Strings.Holidays_AllLocations}}" Header="{x:Static res:Strings.Holidays_Location}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
