<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <StackPanel MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
    <ui:Card Padding="{StaticResource CardPadding}">
      <StackPanel>
        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
          <Image Width="48" Height="48" Margin="0,0,12,0" Source="pack://application:,,,/Assets/app.png" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{x:Static res:Strings.App_Name}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Version}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_DataFolder}" />
        <TextBlock Margin="0,0,0,12" Style="{StaticResource BodyText}" Text="{Binding DataFolder}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_LogFolder}" />
        <TextBlock Margin="0,0,0,12" Style="{StaticResource BodyText}" Text="{Binding LogFolder}" />
        <TextBlock Margin="0,0,0,16" Style="{StaticResource Caption}">
          <Run Text="{Binding Runtime, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding OperatingSystem, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding OpenDataCommand}" Content="{x:Static res:Strings.App_OpenDataFolder}" Icon="{ui:SymbolIcon FolderOpen20}" />
          <ui:Button Command="{Binding OpenLogsCommand}" Content="{x:Static res:Strings.Settings_OpenLogs}" Icon="{ui:SymbolIcon DocumentText20}" />
        </StackPanel>
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding ExportDiagnosticsCommand}" Content="{x:Static res:Strings.Settings_ExportDiagnostics}" Icon="{ui:SymbolIcon Bug20}" />
          <ui:Button
              Command="{Binding ExportAllDataCommand}"
              Content="{x:Static res:Strings.Settings_ExportAllData}"
              Icon="{ui:SymbolIcon DatabaseArrowDown20}"
              Visibility="{Binding CanExportData, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Settings_ExportHint}" TextWrapping="Wrap" />
      </StackPanel>
    </ui:Card>
  </StackPanel>
</UserControl>
