<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mvvm="clr-namespace:SuperOfc.Desktop.Mvvm">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
    <ListBox
        Grid.Row="1"
        Background="Transparent"
        BorderThickness="0"
        ItemContainerStyle="{StaticResource NavListItem}"
        ItemsSource="{Binding Sections}"
        SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="{Binding Icon}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ContentControl
        Grid.Row="1"
        Grid.Column="2"
        Content="{Binding Content}"
        ContentTemplateSelector="{x:Static mvvm:ViewLocator.Instance}"
        Focusable="False" />
  </Grid>
</UserControl>
