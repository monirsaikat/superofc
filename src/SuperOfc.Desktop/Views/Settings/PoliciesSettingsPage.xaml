<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.PoliciesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mvvm="clr-namespace:SuperOfc.Desktop.Mvvm"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Policies_EffectiveFrom}" />
        <DatePicker Width="150" Margin="0,0,12,0" SelectedDate="{Binding EffectiveFrom}" />
        <ui:Button
            Appearance="Primary"
            Command="{Binding SaveCommand}"
            Content="{x:Static res:Strings.App_Save}"
            Icon="{ui:SymbolIcon Save20}"
            IsEnabled="{Binding IsDirty}" />
      </StackPanel>
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Policies_General}" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Policies_IdleLock}" />
                <ui:NumberBox MaxDecimalPlaces="0" Minimum="0" Value="{Binding IdleLockMinutes}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Policies_AutoSync}" />
                <ui:NumberBox MaxDecimalPlaces="0" Minimum="1" Value="{Binding AutoSyncMinutes}" />
              </StackPanel>
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Policies_MaxFailed}" />
                <ui:NumberBox MaxDecimalPlaces="0" Minimum="1" Value="{Binding MaxFailedLogins}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Policies_LockoutMinutes}" />
                <ui:NumberBox MaxDecimalPlaces="0" Minimum="1" Value="{Binding LockoutMinutes}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </ui:Card>

        <ItemsControl ItemsSource="{Binding Editors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Header}" />
                  <ContentControl Content="{Binding}" ContentTemplateSelector="{x:Static mvvm:ViewLocator.Instance}" Focusable="False" />
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,8,0,8" Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Policies_History}" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Caption}">
                <Run Text="{Binding EffectiveFrom, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding CreatedBy, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
