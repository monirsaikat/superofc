<UserControl
    x:Class="SuperOfc.Desktop.Views.Settings.CompanySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
      <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding SaveCommand}"
          Content="{x:Static res:Strings.App_Save}"
          Icon="{ui:SymbolIcon Save20}"
          IsEnabled="{Binding IsDirty}" />
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
          <StackPanel>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_CompanyName}" />
              <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_Address}" />
              <ui:TextBox AcceptsReturn="True" MinLines="2" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
            </StackPanel>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_Phone}" />
                <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_Email}" />
                <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_TaxId}" />
                <ui:TextBox Text="{Binding TaxIdentifier, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_SignatoryName}" />
                <ui:TextBox MaxLength="150" Text="{Binding SignatoryName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Settings_SignatoryTitle}" />
                <ui:TextBox MaxLength="100" Text="{Binding SignatoryTitle, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Settings_SignatoryHint}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
          <StackPanel>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_CurrencyCode}" />
                <ui:TextBox CharacterCasing="Upper" MaxLength="3" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
              </StackPanel>
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_CurrencySymbol}" />
                <ui:TextBox MaxLength="5" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_Grouping}" />
                <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Groupings}" SelectedValue="{Binding Grouping}" SelectedValuePath="Value" />
              </StackPanel>
            </UniformGrid>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_TimeZone}" />
              <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding TimeZones}" SelectedValue="{Binding TimeZoneId, ValidatesOnNotifyDataErrors=True}" SelectedValuePath="Value" />
            </StackPanel>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_FiscalStart}" />
                <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Months}" SelectedValue="{Binding FiscalYearStartMonth}" SelectedValuePath="Value" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_DateFormat}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding DateFormats}" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </ui:Card>

        <ui:Card Padding="{StaticResource CardPadding}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_WorkingWeek}" />
            <ItemsControl ItemsSource="{Binding Week.Days}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}" Text="{Binding Name}" />
                    <ComboBox
                        Grid.Column="1"
                        DisplayMemberPath="Text"
                        ItemsSource="{x:Static vm:WorkingWeekEditor.Types}"
                        SelectedValue="{Binding Type}"
                        SelectedValuePath="Value" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
