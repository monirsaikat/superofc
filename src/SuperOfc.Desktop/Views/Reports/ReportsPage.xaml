<UserControl
    x:Class="SuperOfc.Desktop.Views.Reports.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase">
  <UserControl.Resources>
    <CollectionViewSource x:Key="Catalog" Source="{Binding Reports}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Category" />
      </CollectionViewSource.GroupDescriptions>
      <CollectionViewSource.SortDescriptions>
        <cm:SortDescription PropertyName="Category" />
        <cm:SortDescription PropertyName="Name" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>
  <DockPanel Margin="{StaticResource PagePadding}">
    <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />

    <!-- Catalog -->
    <ListBox
        Width="240"
        Margin="0,0,16,0"
        DisplayMemberPath="Name"
        DockPanel.Dock="Left"
        ItemsSource="{Binding Source={StaticResource Catalog}}"
        SelectedItem="{Binding SelectedReport}">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Margin="4,10,0,4" Style="{StaticResource Caption}" Text="{Binding Name}" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
    </ListBox>

    <!-- Choices -->
    <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedReport.Name}" />
      <TextBlock Margin="0,2,0,10" Style="{StaticResource Caption}" Text="{Binding SelectedReport.Description}" TextWrapping="Wrap" />
      <WrapPanel>
        <ItemsControl ItemsSource="{Binding Parameters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,12,8">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <ComboBox
                    Width="160"
                    ItemStringFormat="MMMM yyyy"
                    ItemsSource="{Binding Months}"
                    SelectedItem="{Binding Month}"
                    Visibility="{Binding IsMonth, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}">
                  <DatePicker Width="130" Margin="0,0,6,0" SelectedDate="{Binding From}" ToolTip="{x:Static res:Strings.Punches_From}" />
                  <DatePicker Width="130" SelectedDate="{Binding To}" ToolTip="{x:Static res:Strings.Punches_To}" />
                </StackPanel>
                <ComboBox
                    Width="130"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Years}"
                    SelectedValue="{Binding Year}"
                    SelectedValuePath="Value"
                    Visibility="{Binding IsYear, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox
                    Width="190"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Options}"
                    SelectedValue="{Binding Selected}"
                    SelectedValuePath="Value"
                    Visibility="{Binding IsOptions, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Margin="0,18,0,8" VerticalAlignment="Top" Orientation="Horizontal">
          <ui:Button
              Margin="0,0,8,0"
              Appearance="Primary"
              Command="{Binding RunCommand}"
              Content="{x:Static res:Strings.Reports_Run}"
              Icon="{ui:SymbolIcon Play20}"
              IsDefault="True" />
          <ui:Button Margin="0,0,8,0" Command="{Binding ExportPdfCommand}" Content="{x:Static res:Strings.Reports_Pdf}" Icon="{ui:SymbolIcon DocumentPdf20}" />
          <ui:Button Command="{Binding ExportExcelCommand}" Content="{x:Static res:Strings.Reports_Excel}" Icon="{ui:SymbolIcon ArrowExportUp20}" />
        </StackPanel>
      </WrapPanel>
      <TextBlock
          Margin="0,0,0,8"
          Style="{StaticResource ErrorText}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap"
          Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
      <TextBlock Margin="0,0,0,8" Style="{StaticResource Caption}" Text="{Binding StatusText}" />
    </StackPanel>

    <ItemsControl Margin="0,8,0,0" DockPanel.Dock="Bottom" ItemsSource="{Binding Notes}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Style="{StaticResource Caption}" Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid>
      <DataGrid
          x:Name="Preview"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserSortColumns="False"
          HeadersVisibility="Column"
          IsReadOnly="True"
          ItemsSource="{Binding Rows}"
          Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}}">
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTotal}" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>
      <TextBlock
          MaxWidth="420"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.Reports_Empty}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="{Binding HasTable, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
