<UserControl
    x:Class="SuperOfc.Desktop.Views.Entry.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <Grid>
    <StackPanel
        MaxWidth="520"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
      <Image
          Width="72"
          Height="72"
          Margin="0,0,0,16"
          Source="pack://application:,,,/Assets/app.png" />
      <TextBlock
          HorizontalAlignment="Center"
          Style="{StaticResource SectionTitle}"
          Text="{x:Static res:Strings.App_Name}" />

      <StackPanel Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}">
        <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True" />
        <TextBlock
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Style="{StaticResource Caption}"
            Text="{Binding Message}" />
      </StackPanel>

      <ui:Card Padding="20" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ErrorTitle}" />
          <TextBlock Style="{StaticResource BodyText}" Text="{Binding ErrorMessage}" />
          <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Appearance="Primary"
                Command="{Binding RestoreCommand}"
                Content="{x:Static res:Strings.App_RestoreBackup}"
                Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding OpenDataFolderCommand}"
                Content="{x:Static res:Strings.App_OpenDataFolder}" />
            <ui:Button Command="{Binding ExitCommand}" Content="{x:Static res:Strings.App_Exit}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </Grid>
</UserControl>
