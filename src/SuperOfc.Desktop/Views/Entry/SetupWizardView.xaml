<UserControl
    x:Class="SuperOfc.Desktop.Views.Entry.SetupWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Width="620" Style="{StaticResource EntryCard}"
        Margin="0,24">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,4" Text="{x:Static res:Strings.Setup_Title}" />
        <TextBlock Margin="0,0,0,16" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Setup_Subtitle}" />

        <!-- Step indicator -->
        <ItemsControl Margin="0,0,0,20" ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,8,0">
                <Border Height="3" CornerRadius="2">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReached}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding StepTitle}" />

        <!-- Step 1: company -->
        <StackPanel Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=0}">
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_CompanyName}" />
            <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_CurrencyCode}" />
              <ui:TextBox MaxLength="3" CharacterCasing="Upper" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_CurrencySymbol}" />
              <ui:TextBox MaxLength="5" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
          </Grid>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_Grouping}" />
            <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Groupings}" SelectedValue="{Binding Grouping}" SelectedValuePath="Value" />
          </StackPanel>
        </StackPanel>

        <!-- Step 2: region -->
        <StackPanel Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=1}">
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_TimeZone}" />
            <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding TimeZones}" SelectedValue="{Binding TimeZoneId, ValidatesOnNotifyDataErrors=True}" SelectedValuePath="Value" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_FiscalStart}" />
              <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Months}" SelectedValue="{Binding FiscalYearStartMonth}" SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_DateFormat}" />
              <ComboBox IsEditable="True" ItemsSource="{Binding DateFormats}" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding DatePreview}" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_WorkingWeek}" />
          <ItemsControl ItemsSource="{Binding Week.Days}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="180" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}" Text="{Binding Name}" />
                  <ComboBox
                      Grid.Column="1"
                      DisplayMemberPath="Text"
                      ItemsSource="{x:Static vm:WorkingWeekEditor.Types}"
                      SelectedValue="{Binding Type}"
                      SelectedValuePath="Value" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Step 3: administrator -->
        <StackPanel Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=2}">
          <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Setup_AdminHint}" />
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_DisplayName}" />
            <ui:TextBox Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Login_Username}" />
            <ui:TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Login_Password}" />
            <ui:PasswordBox Password="{Binding AdminPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Setup_PasswordHint}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Setup_ConfirmPassword}" />
            <ui:PasswordBox Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
          </StackPanel>
        </StackPanel>

        <!-- Step 4: finish -->
        <StackPanel Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=3}">
          <TextBlock Margin="0,0,0,16" Style="{StaticResource BodyText}" Text="{Binding Summary}" />
          <CheckBox Content="{x:Static res:Strings.Setup_SampleData}" IsChecked="{Binding LoadSampleData}" />
          <TextBlock Margin="28,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Setup_SampleDataHint}" />
        </StackPanel>

        <TextBlock
            Margin="0,12,0,0"
            Style="{StaticResource ErrorText}"
            Text="{Binding ErrorMessage}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

        <Grid Margin="0,24,0,0">
          <ui:Button
              HorizontalAlignment="Left"
              Command="{Binding BackCommand}"
              Content="{x:Static res:Strings.App_Back}" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:ProgressRing
                Width="20"
                Height="20"
                Margin="0,0,12,0"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Appearance="Primary"
                Command="{Binding NextCommand}"
                Content="{x:Static res:Strings.App_Next}"
                IsDefault="True"
                Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button
                Appearance="Primary"
                Command="{Binding NextCommand}"
                Content="{x:Static res:Strings.Setup_Create}"
                Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
