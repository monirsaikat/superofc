<UserControl
    x:Class="SuperOfc.Desktop.Views.Loans.EmployeeLoansTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}" Text="{Binding Summary}" />
      <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding NewCommand}"
          Content="{x:Static res:Strings.Loans_New}"
          Icon="{ui:SymbolIcon Add20}"
          Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <Grid>
      <DataGrid ItemsSource="{Binding Loans}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="80" Binding="{Binding Number}" Header="{x:Static res:Strings.Loans_Number}" />
          <DataGridTextColumn Width="90" Binding="{Binding Kind, Converter={StaticResource EnumText}, ConverterParameter=LoanKind}" Header="{x:Static res:Strings.Loans_Kind}" />
          <DataGridTextColumn Width="110" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=LoanStatus}" Header="{x:Static res:Strings.Payroll_Status}" />
          <DataGridTextColumn Width="*" Binding="{Binding Principal, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Amount}" />
          <DataGridTextColumn Width="*" Binding="{Binding Installment, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Installment}" />
          <DataGridTextColumn Width="*" Binding="{Binding Outstanding, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Outstanding}" />
          <DataGridTemplateColumn Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ui:Button
                    Padding="8,2"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"
                    Content="{x:Static res:Strings.App_Open}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.EmpLoans_None}"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
