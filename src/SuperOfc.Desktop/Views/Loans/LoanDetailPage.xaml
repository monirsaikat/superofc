<UserControl
    x:Class="SuperOfc.Desktop.Views.Loans.LoanDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource Caption}" Text="{Binding TermsText}" TextWrapping="Wrap" />
      </StackPanel>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding BackCommand}" Content="{x:Static res:Strings.Loans_All}" Icon="{ui:SymbolIcon ArrowLeft20}" />
    </Grid>

    <!-- Actions for the current state -->
    <WrapPanel Margin="0,4,0,8" DockPanel.Dock="Top">
      <ui:Button Margin="0,0,8,8" Command="{Binding EditCommand}" Content="{x:Static res:Strings.App_Edit}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding ApproveCommand}" Content="{x:Static res:Strings.LoanDetail_Approve}" Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Command="{Binding RejectCommand}" Content="{x:Static res:Strings.LoanDetail_Reject}" Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding DisburseCommand}" Content="{x:Static res:Strings.LoanDetail_Disburse}" Visibility="{Binding CanDisburse, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Command="{Binding RepayCommand}" Content="{x:Static res:Strings.LoanDetail_Repay}" Visibility="{Binding CanRepay, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Command="{Binding SettleCommand}" Content="{x:Static res:Strings.LoanDetail_Settle}" Visibility="{Binding CanRepay, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Appearance="Danger" Command="{Binding WriteOffCommand}" Content="{x:Static res:Strings.LoanDetail_WriteOff}" Visibility="{Binding CanWriteOff, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Appearance="Danger" Command="{Binding DeleteCommand}" Content="{x:Static res:Strings.App_Delete}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
      <ui:Button Margin="0,0,8,8" Command="{Binding ExportCommand}" Content="{x:Static res:Strings.LoanDetail_Statement}" Icon="{ui:SymbolIcon DocumentPdf20}" />
    </WrapPanel>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <!-- Balance tiles -->
    <UniformGrid Margin="0,0,0,12" Columns="4" DockPanel.Dock="Top">
      <ui:Card Margin="0,0,8,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.Payroll_Status}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Loan.Summary.Status, Converter={StaticResource EnumText}, ConverterParameter=LoanStatus}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,8,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.LoanDetail_Total}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Loan.Summary.Total, Converter={StaticResource Money}}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,8,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.LoanDetail_Repaid}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Loan.Balance.Repaid, Converter={StaticResource Money}}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.Loans_Outstanding}" />
          <TextBlock Style="{StaticResource TileValue}" Text="{Binding Loan.Balance.Outstanding, Converter={StaticResource Money}}" />
        </StackPanel>
      </ui:Card>
    </UniformGrid>
    <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding SettlementText}" Visibility="{Binding SettlementText, Converter={StaticResource HasValueToVisibility}}" />

    <TabControl>
      <TabItem Header="{x:Static res:Strings.LoanForm_Schedule}">
        <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Loan.Installments}" Style="{StaticResource ListGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="50" Binding="{Binding Sequence}" Header="#" />
            <DataGridTextColumn Width="110" Binding="{Binding DueMonth, StringFormat=MMM yyyy}" Header="{x:Static res:Strings.Payroll_Month}" />
            <DataGridTextColumn Width="110" Binding="{Binding Principal, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.LoanForm_Principal}" />
            <DataGridTextColumn Width="100" Binding="{Binding Interest, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.LoanForm_Interest}" />
            <DataGridTextColumn Width="110" Binding="{Binding Amount, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Installment}" />
            <DataGridTextColumn Width="110" Binding="{Binding Paid, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.LoanDetail_Paid}" />
            <DataGridTextColumn Width="100" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=InstallmentStatus}" Header="{x:Static res:Strings.Payroll_Status}" />
            <DataGridTextColumn Width="*" Binding="{Binding Note}" Header="{x:Static res:Strings.Salary_Note}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static res:Strings.LoanDetail_StatementTab}">
        <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Loan.Statement}" Style="{StaticResource ListGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="110" Binding="{Binding Date, StringFormat=d}" Header="{x:Static res:Strings.LoanDetail_Date}" />
            <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{x:Static res:Strings.LoanDetail_Description}" />
            <DataGridTextColumn Width="120" Binding="{Binding Reference}" Header="{x:Static res:Strings.PayrollRun_Reference}" />
            <DataGridTextColumn Width="110" Binding="{Binding Debit, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.LoanDetail_Lent}" />
            <DataGridTextColumn Width="110" Binding="{Binding Credit, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.LoanDetail_Repaid}" />
            <DataGridTextColumn Width="120" Binding="{Binding Balance, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.LoanDetail_Balance}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
