<UserControl
    x:Class="SuperOfc.Desktop.Views.Loans.LoansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Loans">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <ui:Button
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Appearance="Primary"
          Command="{Binding NewCommand}"
          Content="{x:Static res:Strings.Loans_New}"
          Icon="{ui:SymbolIcon Add20}"
          Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
      <ComboBox Width="200" Margin="0,0,8,0" DisplayMemberPath="Text" ItemsSource="{x:Static vm:LoansViewModel.Statuses}" SelectedValue="{Binding Status}" SelectedValuePath="Value" />
      <ui:TextBox
          Width="260"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.Loans_SearchHint}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
    </WrapPanel>
    <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding TotalsText}" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <Grid>
      <DataGrid ItemsSource="{Binding Loans}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
        <DataGrid.InputBindings>
          <MouseBinding Command="{Binding OpenCommand}" Gesture="LeftDoubleClick" />
          <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Width="80" Binding="{Binding Number}" Header="{x:Static res:Strings.Loans_Number}" />
          <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" />
          <DataGridTextColumn Width="80" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
          <DataGridTextColumn Width="90" Binding="{Binding Kind, Converter={StaticResource EnumText}, ConverterParameter=LoanKind}" Header="{x:Static res:Strings.Loans_Kind}" />
          <DataGridTextColumn Width="110" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=LoanStatus}" Header="{x:Static res:Strings.Payroll_Status}" />
          <DataGridTextColumn Width="120" Binding="{Binding Principal, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Amount}" />
          <DataGridTextColumn Width="110" Binding="{Binding Installment, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Installment}" />
          <DataGridTemplateColumn Width="80" Header="{x:Static res:Strings.Loans_Progress}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding InstallmentsDone, Mode=OneWay}" />
                  <Run Text="/" />
                  <Run Text="{Binding InstallmentCount, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="120" Binding="{Binding Outstanding, Converter={StaticResource Money}, ConverterParameter=plain}" Header="{x:Static res:Strings.Loans_Outstanding}" />
          <DataGridTextColumn Width="100" Binding="{Binding NextDue, StringFormat=MMM yyyy}" Header="{x:Static res:Strings.Loans_NextDue}" />
          <DataGridTemplateColumn Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ui:SymbolIcon
                    Foreground="{StaticResource StatusAbsentBrush}"
                    Symbol="PersonWarning20"
                    ToolTip="{x:Static res:Strings.Loans_Receivable}"
                    Visibility="{Binding IsReceivable, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          MaxWidth="420"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.Loans_Empty}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
