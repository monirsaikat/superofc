<UserControl
    x:Class="SuperOfc.Desktop.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,4" Text="{Binding Title}" />
      <TextBlock Margin="0,0,0,24" Style="{StaticResource Caption}" Text="{Binding Welcome}" />
      <ui:ProgressRing
          Width="28"
          Height="28"
          Margin="0,0,0,16"
          HorizontalAlignment="Left"
          IsIndeterminate="True"
          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:CardAction
                Width="250"
                Height="120"
                Margin="0,0,12,12"
                Padding="16"
                VerticalContentAlignment="Top"
                Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}"
                IsChevronVisible="False">
              <StackPanel>
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                  <ui:SymbolIcon Margin="0,0,8,0" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="{Binding Icon}" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                </StackPanel>
                <TextBlock Style="{StaticResource TileValue}" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardAction>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
