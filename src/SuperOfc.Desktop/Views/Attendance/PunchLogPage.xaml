<UserControl
    x:Class="SuperOfc.Desktop.Views.Attendance.PunchLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Attendance">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <ui:Button
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Appearance="Primary"
          Command="{Binding StartAddCommand}"
          Content="{x:Static res:Strings.Punches_Add}"
          Icon="{ui:SymbolIcon Add20}"
          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top">
      <DatePicker Width="140" Margin="0,0,8,0" SelectedDate="{Binding From}" ToolTip="{x:Static res:Strings.Punches_From}" />
      <DatePicker Width="140" Margin="0,0,8,0" SelectedDate="{Binding To}" ToolTip="{x:Static res:Strings.Punches_To}" />
      <ComboBox Width="150" Margin="0,0,8,0" DisplayMemberPath="Text" ItemsSource="{x:Static vm:PunchLogViewModel.Sources}" SelectedValue="{Binding Source}" SelectedValuePath="Value" />
      <ui:TextBox
          Width="240"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.Attendance_SearchHint}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
    </WrapPanel>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
    <Grid Margin="0,8,0,0" DockPanel.Dock="Bottom">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding PageText}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Command="{Binding PreviousPageCommand}" Content="{x:Static res:Strings.Employees_Previous}" />
        <ui:Button Command="{Binding NextPageCommand}" Content="{x:Static res:Strings.Employees_NextPage}" />
      </StackPanel>
    </Grid>

    <ui:Card
        Width="320"
        Margin="16,0,0,0"
        Padding="{StaticResource CardPadding}"
        VerticalAlignment="Top"
        DockPanel.Dock="Right"
        Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Punches_Employee}" />
          <ComboBox
              DisplayMemberPath="Name"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding Employees}"
              SelectedValue="{Binding NewEmployeeId}"
              SelectedValuePath="Id"
              TextSearch.TextPath="Name" />
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Holidays_Date}" />
            <DatePicker SelectedDate="{Binding NewDate}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Attendance_PunchTime}" />
            <ui:TextBox PlaceholderText="09:00" Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Punches_Reason}" />
          <ui:TextBox Text="{Binding NewReason, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveAddCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Command="{Binding CancelAddCommand}" Content="{x:Static res:Strings.App_Cancel}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <DataGrid ItemsSource="{Binding Punches}" Style="{StaticResource ListGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="150" Binding="{Binding LocalTime, StringFormat=ddd d MMM HH:mm}" Header="{x:Static res:Strings.Punches_Time}" />
        <DataGridTextColumn Width="90" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
        <DataGridTextColumn Width="*" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" />
        <DataGridTextColumn Width="90" Binding="{Binding Source, Converter={StaticResource EnumText}, ConverterParameter=Source}" Header="{x:Static res:Strings.Punches_Source}" />
        <DataGridTextColumn Width="*" Binding="{Binding Reason}" Header="{x:Static res:Strings.Punches_Reason}" />
        <DataGridTextColumn Width="100" Binding="{Binding CreatedBy}" Header="{x:Static res:Strings.Punches_By}" />
        <DataGridTemplateColumn Width="50">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ui:Button
                  Padding="4"
                  Appearance="Transparent"
                  Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  CommandParameter="{Binding}"
                  Icon="{ui:SymbolIcon Delete16}"
                  ToolTip="{x:Static res:Strings.App_Delete}"
                  Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
