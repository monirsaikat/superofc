<ui:FluentWindow
    x:Class="SuperOfc.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mvvm="clr-namespace:SuperOfc.Desktop.Mvvm"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    Title="{Binding WindowTitle}"
    Width="1320"
    Height="820"
    MinWidth="1000"
    MinHeight="620"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Command="{Binding LockNowCommand}" Gesture="Ctrl+L" />
    <KeyBinding Command="{Binding RefreshPageCommand}" Gesture="F5" />
    <KeyBinding Command="{Binding NewOnPageCommand}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding GoBackCommand}" Gesture="Alt+Left" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ProgressBar
        Grid.Row="1"
        Height="2"
        Margin="0"
        IsIndeterminate="True"
        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

    <ItemsControl Grid.Row="2" Margin="16,0,16,0" ItemsSource="{Binding InfoBars}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border
              Margin="0,4,0,0"
              Padding="12,8"
              BorderThickness="1"
              CornerRadius="6">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Severity}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsOpen}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <ui:Button
                  Padding="6"
                  Appearance="Transparent"
                  AutomationProperties.Name="{x:Static res:Strings.App_Close}"
                  Command="{Binding CloseCommand}"
                  DockPanel.Dock="Right"
                  Icon="{ui:SymbolIcon Dismiss16}" />
              <ui:Button
                  Margin="12,0,8,0"
                  Appearance="Primary"
                  Command="{Binding ActionCommand}"
                  Content="{Binding ActionText}"
                  DockPanel.Dock="Right"
                  Visibility="{Binding ActionText, Converter={StaticResource HasValueToVisibility}}" />
              <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" FontSize="18" Symbol="Info24" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                <Run Text="  " />
                <Run Text="{Binding Message, Mode=OneWay}" />
              </TextBlock>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ContentControl
        Grid.Row="3"
        Content="{Binding CurrentScreen}"
        ContentTemplateSelector="{x:Static mvvm:ViewLocator.Instance}"
        Focusable="False" />

    <ContentControl
        Grid.Row="0"
        Grid.RowSpan="4"
        Content="{Binding Lock}"
        ContentTemplateSelector="{x:Static mvvm:ViewLocator.Instance}"
        Focusable="False"
        Visibility="{Binding Lock, Converter={StaticResource HasValueToVisibility}}" />

    <ui:SnackbarPresenter x:Name="Snackbar" Grid.Row="3" VerticalAlignment="Bottom" />
    <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="4" />
  </Grid>
</ui:FluentWindow>
