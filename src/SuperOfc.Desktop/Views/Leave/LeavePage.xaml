<UserControl
    x:Class="SuperOfc.Desktop.Views.Leave.LeavePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Leave">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <ui:Button
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Appearance="Primary"
          Command="{Binding StartNewCommand}"
          Content="{x:Static res:Strings.Leave_New}"
          Icon="{ui:SymbolIcon Add20}"
          Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <ui:InfoBar
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        IsClosable="False"
        IsOpen="True"
        Message="{Binding LockText}"
        Severity="Informational"
        Title="{x:Static res:Strings.Payroll_LockTitle}"
        Visibility="{Binding LockText, Converter={StaticResource HasValueToVisibility}}" />
    <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top">
      <ComboBox Width="200" Margin="0,0,8,0" DisplayMemberPath="Text" ItemsSource="{x:Static vm:LeaveViewModel.Statuses}" SelectedValue="{Binding Status}" SelectedValuePath="Value" />
      <ui:TextBox
          Width="240"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.Attendance_SearchHint}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
    </WrapPanel>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <!-- Right column: new request form or selected request actions, plus balances -->
    <StackPanel Width="340" Margin="16,0,0,0" DockPanel.Dock="Right">
      <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Leave_New}" />
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_Employee}" />
            <ComboBox
                DisplayMemberPath="Name"
                IsEditable="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Employees}"
                SelectedValue="{Binding NewEmployeeId}"
                SelectedValuePath="Id"
                TextSearch.TextPath="Name" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_Type}" />
            <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Types}" SelectedValue="{Binding NewTypeId}" SelectedValuePath="Id" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="8" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_From}" />
              <DatePicker SelectedDate="{Binding NewFrom}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Style="{StaticResource Field}" IsEnabled="{Binding NewHalfDay, Converter={StaticResource InverseBool}}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_To}" />
              <DatePicker SelectedDate="{Binding NewTo}" />
            </StackPanel>
          </Grid>
          <CheckBox Margin="{StaticResource FieldMargin}" Content="{x:Static res:Strings.Leave_HalfDay}" IsChecked="{Binding NewHalfDay}" />
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_Reason}" />
            <ui:TextBox Text="{Binding NewReason, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Leave_Attachment}" />
            <DockPanel>
              <ui:Button Margin="8,0,0,0" Command="{Binding ChooseAttachmentCommand}" Content="{x:Static res:Strings.Leave_ChooseFile}" DockPanel.Dock="Right" />
              <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding NewAttachment}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </StackPanel>
          <CheckBox
              Margin="{StaticResource FieldMargin}"
              Content="{x:Static res:Strings.Leave_ApproveNow}"
              IsChecked="{Binding NewApproveNow}"
              Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SubmitCommand}" Content="{x:Static res:Strings.Leave_Submit}" />
            <ui:Button Command="{Binding CancelNewCommand}" Content="{x:Static res:Strings.App_Cancel}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}" Visibility="{Binding Selected, Converter={StaticResource HasValueToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Selected.EmployeeName}" />
          <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}">
            <Run Text="{Binding Selected.LeaveType, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding Selected.Days, Mode=OneWay, StringFormat=0.#}" />
            <Run Text="{x:Static res:Strings.Leave_Days}" />
          </TextBlock>
          <TextBlock Margin="0,0,0,8" Text="{Binding Selected.Reason}" TextWrapping="Wrap" />
          <WrapPanel>
            <ui:Button
                Margin="0,0,8,8"
                Appearance="Primary"
                Command="{Binding ApproveCommand}"
                Content="{x:Static res:Strings.Leave_Approve}"
                Icon="{ui:SymbolIcon Checkmark20}"
                Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,8"
                Command="{Binding RejectCommand}"
                Content="{x:Static res:Strings.Leave_Reject}"
                Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,8"
                Appearance="Danger"
                Command="{Binding CancelLeaveCommand}"
                Content="{x:Static res:Strings.Leave_Cancel}"
                Visibility="{Binding CanCancelSelected, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>
        </StackPanel>
      </ui:Card>

      <ui:Card Padding="{StaticResource CardPadding}" Visibility="{Binding Balances.Count, Converter={StaticResource HasValueToVisibility}}">
        <StackPanel>
          <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Leave_Balances}" />
          <ItemsControl ItemsSource="{Binding Balances}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <TextBlock Text="{Binding LeaveType}" />
                  <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Closing, StringFormat=0.#}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>
    </StackPanel>

    <Grid>
      <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="80" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
          <DataGridTextColumn Width="*" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.Employees_Name}" />
          <DataGridTextColumn Width="120" Binding="{Binding LeaveType}" Header="{x:Static res:Strings.Leave_Type}" />
          <DataGridTextColumn Width="100" Binding="{Binding FromDate, StringFormat=d}" Header="{x:Static res:Strings.Leave_From}" />
          <DataGridTextColumn Width="100" Binding="{Binding ToDate, StringFormat=d}" Header="{x:Static res:Strings.Leave_To}" />
          <DataGridTextColumn Width="60" Binding="{Binding Days, StringFormat=0.#}" Header="{x:Static res:Strings.Leave_Days}" />
          <DataGridTextColumn Width="100" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=LeaveStatus}" Header="{x:Static res:Strings.Leave_Status}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.Leave_NoPending}"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
