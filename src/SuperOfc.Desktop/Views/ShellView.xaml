<UserControl
    x:Class="SuperOfc.Desktop.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mvvm="clr-namespace:SuperOfc.Desktop.Mvvm"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <UserControl.Resources>
    <DataTemplate x:Key="NavItemTemplate">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Margin="0,0,12,0" FontSize="18" Symbol="{Binding Icon}" />
        <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation pane -->
    <DockPanel Grid.Column="0" Margin="8,4,4,8">
      <StackPanel DockPanel.Dock="Bottom">
        <ListBox
            AutomationProperties.Name="Settings"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource NavListItem}"
            ItemTemplate="{StaticResource NavItemTemplate}"
            ItemsSource="{Binding FooterItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
        <Separator Margin="4,8" />
        <Grid Margin="8,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
              Width="32"
              Height="32"
              Margin="0,0,10,0"
              Background="{DynamicResource AccentFillColorDefaultBrush}"
              CornerRadius="16">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                Text="{Binding Initials}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontSize="13" Style="{StaticResource BodyText}" Text="{Binding UserDisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding RoleText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <ui:Button
                Padding="6"
                Appearance="Transparent"
                AutomationProperties.Name="{x:Static res:Strings.Nav_Lock}"
                Command="{Binding Main.LockNowCommand}"
                Icon="{ui:SymbolIcon LockClosed20}"
                ToolTip="{x:Static res:Strings.Nav_Lock}" />
            <ui:Button
                Padding="6"
                Appearance="Transparent"
                AutomationProperties.Name="{x:Static res:Strings.Nav_SignOut}"
                Command="{Binding Main.SignOutCommand}"
                Icon="{ui:SymbolIcon SignOut20}"
                ToolTip="{x:Static res:Strings.Nav_SignOut}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="12,6,0,0" Style="{StaticResource Caption}" Text="{Binding VersionText}" />
      </StackPanel>
      <ListBox
          AutomationProperties.Name="Navigation"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource NavListItem}"
          ItemTemplate="{StaticResource NavItemTemplate}"
          ItemsSource="{Binding Items}"
          SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
    </DockPanel>

    <!-- Content area -->
    <Border
        Grid.Column="1"
        Margin="0,0,0,0"
        Background="{DynamicResource LayerFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:Button
            Margin="16,12,0,0"
            HorizontalAlignment="Left"
            Appearance="Transparent"
            AutomationProperties.Name="{x:Static res:Strings.App_Back}"
            Command="{Binding GoBackCommand}"
            Icon="{ui:SymbolIcon ArrowLeft20}"
            Content="{x:Static res:Strings.App_Back}"
            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
        <ContentControl
            Grid.Row="1"
            Content="{Binding CurrentPage}"
            ContentTemplateSelector="{x:Static mvvm:ViewLocator.Instance}"
            Focusable="False" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
