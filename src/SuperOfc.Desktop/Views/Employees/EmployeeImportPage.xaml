<UserControl
    x:Class="SuperOfc.Desktop.Views.Employees.EmployeeImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel Margin="{StaticResource PagePadding}">
    <TextBlock Margin="0,0,0,16" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <Grid>
      <!-- Step 1: choose file -->
      <ui:Card
          MaxWidth="640"
          Padding="24"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Visibility="{Binding IsFileStep, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Margin="0,0,0,16" Style="{StaticResource BodyText}" Text="{x:Static res:Strings.Import_Intro}" TextWrapping="Wrap" />
          <CheckBox Margin="0,0,0,16" Content="{x:Static res:Strings.Import_CreateLookups}" IsChecked="{Binding CreateLookups}" />
          <StackPanel Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding DownloadTemplateCommand}"
                Content="{x:Static res:Strings.Import_DownloadTemplate}"
                Icon="{ui:SymbolIcon ArrowDownload20}" />
            <ui:Button
                Appearance="Primary"
                Command="{Binding ChooseFileCommand}"
                Content="{x:Static res:Strings.Import_ChooseFile}"
                Icon="{ui:SymbolIcon FolderOpen20}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <!-- Step 2: check -->
      <DockPanel Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="0,0,0,12" DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Caption}" Text="{Binding FilePath}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionTitle}" Text="{Binding SummaryText}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyText}" Text="{Binding NewLookupsText}" TextWrapping="Wrap" Visibility="{Binding NewLookupsText, Converter={StaticResource HasValueToVisibility}}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource ErrorText}" Text="{x:Static res:Strings.Import_FixAndRetry}" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding RestartCommand}" Content="{x:Static res:Strings.App_Back}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding CheckCommand}" Content="{x:Static res:Strings.Import_CheckAgain}" Icon="{ui:SymbolIcon ArrowClockwise20}" />
          <ui:Button
              Margin="0,0,8,0"
              Command="{Binding ExportErrorsCommand}"
              Content="{x:Static res:Strings.Import_ExportErrors}"
              Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Appearance="Primary" Command="{Binding RunCommand}" Content="{Binding RunText}" Icon="{ui:SymbolIcon ArrowUpload20}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ListGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="60" Binding="{Binding RowNumber}" Header="{x:Static res:Strings.Import_Row}" />
            <DataGridTextColumn Width="100" Binding="{Binding Code}" Header="{x:Static res:Strings.Employees_Code}" />
            <DataGridTextColumn Width="220" Binding="{Binding FullName}" Header="{x:Static res:Strings.Employees_Name}" />
            <DataGridTemplateColumn Width="*" Header="{x:Static res:Strings.Import_Problems}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Foreground="{StaticResource StatusAbsentBrush}" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- Step 3: done -->
      <ui:Card
          MaxWidth="520"
          Padding="24"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <ui:SymbolIcon Margin="0,0,0,12" HorizontalAlignment="Left" FontSize="40" Foreground="{StaticResource StatusPresentBrush}" Symbol="CheckmarkCircle24" />
          <TextBlock Margin="0,0,0,16" Style="{StaticResource SectionTitle}" Text="{Binding DoneText}" />
          <ui:Button Appearance="Primary" Command="{Binding OpenEmployeesCommand}" Content="{x:Static res:Strings.Import_OpenEmployees}" />
        </StackPanel>
      </ui:Card>
    </Grid>
  </DockPanel>
</UserControl>
