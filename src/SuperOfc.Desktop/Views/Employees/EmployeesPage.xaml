<UserControl
    x:Class="SuperOfc.Desktop.Views.Employees.EmployeesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Employees">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,16" DockPanel.Dock="Top">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding ExportCommand}"
            Content="{x:Static res:Strings.Employees_Export}"
            Icon="{ui:SymbolIcon ArrowDownload20}" />
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding ImportCommand}"
            Content="{x:Static res:Strings.Employees_Import}"
            Icon="{ui:SymbolIcon ArrowUpload20}"
            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
            Appearance="Primary"
            Command="{Binding NewEmployeeCommand}"
            Content="{x:Static res:Strings.Employees_New}"
            Icon="{ui:SymbolIcon PersonAdd20}"
            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>

    <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top">
      <ui:TextBox
          x:Name="SearchBox"
          Width="300"
          Margin="0,0,8,0"
          Icon="{ui:SymbolIcon Search20}"
          PlaceholderText="{x:Static res:Strings.Employees_SearchHint}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox
          Width="200"
          Margin="0,0,8,0"
          DisplayMemberPath="Name"
          ItemsSource="{Binding Departments}"
          SelectedValue="{Binding DepartmentId}"
          SelectedValuePath="Id" />
      <ComboBox
          Width="170"
          Margin="0,0,8,0"
          DisplayMemberPath="Text"
          ItemsSource="{x:Static vm:EmployeesViewModel.Statuses}"
          SelectedValue="{Binding Status}"
          SelectedValuePath="Value" />
      <CheckBox VerticalAlignment="Center" Content="{x:Static res:Strings.Employees_IncludeLeft}" IsChecked="{Binding IncludeLeft}" />
    </WrapPanel>

    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <Grid Margin="0,8,0,0" DockPanel.Dock="Bottom" Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}">
      <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding PageText}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Command="{Binding PreviousPageCommand}" Content="{x:Static res:Strings.Employees_Previous}" />
        <ui:Button Command="{Binding NextPageCommand}" Content="{x:Static res:Strings.Employees_NextPage}" />
      </StackPanel>
    </Grid>

    <Grid>
      <DataGrid
          x:Name="Grid"
          ItemsSource="{Binding Employees}"
          MouseDoubleClick="OnGridDoubleClick"
          PreviewKeyDown="OnGridKeyDown"
          SelectedItem="{Binding Selected, Mode=TwoWay}"
          Sorting="OnGridSorting"
          Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="44" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                  <Image Source="{Binding PhotoPath, Converter={StaticResource ThumbPath}}" Stretch="UniformToFill" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="90" Binding="{Binding Code}" Header="{x:Static res:Strings.Employees_Code}" SortMemberPath="Code" />
          <DataGridTextColumn Width="2*" Binding="{Binding FullName}" Header="{x:Static res:Strings.Employees_Name}" SortMemberPath="FullName" />
          <DataGridTextColumn Width="*" Binding="{Binding Department}" Header="{x:Static res:Strings.Employees_Department}" SortMemberPath="Department" />
          <DataGridTextColumn Width="*" Binding="{Binding Designation}" CanUserSort="False" Header="{x:Static res:Strings.Employees_Designation}" />
          <DataGridTextColumn Width="120" Binding="{Binding Phone}" CanUserSort="False" Header="{x:Static res:Strings.Employees_Phone}" />
          <DataGridTextColumn Width="110" Binding="{Binding JoinDate, StringFormat=d}" Header="{x:Static res:Strings.Employees_JoinDate}" SortMemberPath="JoinDate" />
          <DataGridTextColumn Width="100" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=Status}" CanUserSort="False" Header="{x:Static res:Strings.Employees_Status}" />
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="48" Symbol="People24" />
        <TextBlock Margin="0,12,0,16" HorizontalAlignment="Center" Style="{StaticResource BodyText}" Text="{x:Static res:Strings.Employees_Empty}" />
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding NewEmployeeCommand}" Content="{x:Static res:Strings.Employees_New}" />
          <ui:Button Command="{Binding ImportCommand}" Content="{x:Static res:Strings.Employees_Import}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
