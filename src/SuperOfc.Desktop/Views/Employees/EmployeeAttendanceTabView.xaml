<UserControl
    x:Class="SuperOfc.Desktop.Views.Employees.EmployeeAttendanceTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel>
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.EmpAtt_CurrentShift}" />
        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding CurrentShift}" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.EmpAtt_ThisMonth}" />
        <TextBlock Text="{Binding MonthSummary}" />
      </StackPanel>
      <ui:Button
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Command="{Binding StartAssignCommand}"
          Content="{x:Static res:Strings.EmpAtt_AssignShift}"
          Icon="{ui:SymbolIcon Clock20}"
          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <ui:Card
        Width="320"
        Margin="16,0,0,0"
        Padding="{StaticResource CardPadding}"
        VerticalAlignment="Top"
        DockPanel.Dock="Right"
        Visibility="{Binding IsAssigning, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Attendance_Shift}" />
          <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Shifts}" SelectedValue="{Binding AssignShiftId}" SelectedValuePath="Id" />
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.EmpAtt_From}" />
            <DatePicker SelectedDate="{Binding AssignFrom}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.EmpAtt_To}" />
            <DatePicker SelectedDate="{Binding AssignTo}" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.EmpAtt_Rotation}" />
            <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding RotationShifts}" SelectedValue="{Binding RotateWithId}" SelectedValuePath="Id" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.EmpAtt_RotationDays}" TextTrimming="CharacterEllipsis" />
            <ui:NumberBox MaxDecimalPlaces="0" Minimum="1" SpinButtonPlacementMode="Hidden" Value="{Binding RotationDays}" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveAssignCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Command="{Binding CancelAssignCommand}" Content="{x:Static res:Strings.App_Cancel}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <DockPanel>
      <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.EmpAtt_ShiftHistory}" />
      <DataGrid ItemsSource="{Binding Assignments}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{x:Static res:Strings.Attendance_Shift}" />
          <DataGridTextColumn Width="110" Binding="{Binding EffectiveFrom, StringFormat=d}" Header="{x:Static res:Strings.EmpAtt_From}" />
          <DataGridTextColumn Width="110" Binding="{Binding EffectiveTo, StringFormat=d}" Header="{x:Static res:Strings.EmpAtt_To}" />
          <DataGridTemplateColumn Width="50">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ui:Button
                    Padding="4"
                    Appearance="Transparent"
                    Command="{Binding DataContext.DeleteAssignmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Delete16}"
                    ToolTip="{x:Static res:Strings.App_Delete}"
                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</UserControl>
