<UserControl
    x:Class="SuperOfc.Desktop.Views.Employees.EmployeeDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Employees">
  <UserControl.Resources>
    <Style x:Key="FormCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="Padding" Value="{StaticResource CardPadding}" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </UserControl.Resources>
  <DockPanel Margin="{StaticResource PagePadding}">
    <!-- Header: photo, name, status, save -->
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Margin="0,0,16,0">
        <Border
            Width="72"
            Height="72"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            ClipToBounds="True"
            CornerRadius="36">
          <Grid>
            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Symbol="Person24" />
            <Image Source="{Binding PhotoFullPath, Converter={StaticResource ImagePath}}" Stretch="UniformToFill" />
          </Grid>
        </Border>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal">
          <Border Margin="0,0,8,0" Style="{StaticResource Badge}" Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=Status}" />
          </Border>
          <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding ConfirmationText}" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding ExitText}" />
        </StackPanel>
        <ui:Button
            Margin="0,6,0,0"
            Padding="6,2"
            Appearance="Transparent"
            Command="{Binding ChangePhotoCommand}"
            Content="{x:Static res:Strings.Employee_ChangePhoto}"
            FontSize="12"
            Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <StackPanel
          Grid.Column="2"
          VerticalAlignment="Top"
          Orientation="Horizontal"
          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
        <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="{x:Static res:Strings.App_Cancel}" />
        <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="{x:Static res:Strings.App_Save}" Icon="{ui:SymbolIcon Save20}" />
      </StackPanel>
    </Grid>

    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}">
      <!-- Profile -->
      <TabItem Header="{x:Static res:Strings.Employee_TabProfile}">
        <ScrollViewer Padding="0,12,0,0" VerticalScrollBarVisibility="Auto">
          <Grid IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Employee_Personal}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employees_Code}" />
                    <ui:TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_FullName}" />
                    <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_Gender}" />
                    <ComboBox
                        DisplayMemberPath="Text"
                        ItemsSource="{x:Static vm:EmployeeDetailViewModel.Genders}"
                        SelectedValue="{Binding Gender}"
                        SelectedValuePath="Value" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_DateOfBirth}" />
                    <DatePicker SelectedDate="{Binding DateOfBirth}" />
                  </StackPanel>
                </Grid>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_FatherName}" />
                  <ui:TextBox MaxLength="200" Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_NationalId}" />
                  <ui:TextBox Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="1" Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Employee_Contact}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employees_Phone}" />
                    <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_Email}" />
                    <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_Address}" />
                  <ui:TextBox AcceptsReturn="True" MinLines="2" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_Emergency}" />
                  <ui:TextBox Text="{Binding EmergencyContact, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="1" Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Employee_Job}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employees_JoinDate}" />
                    <DatePicker SelectedDate="{Binding JoinDate}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employees_Department}" />
                    <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Departments}" SelectedValue="{Binding DepartmentId}" SelectedValuePath="Id" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employees_Designation}" />
                    <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Designations}" SelectedValue="{Binding DesignationId}" SelectedValuePath="Id" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employees_Location}" />
                    <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Locations}" SelectedValue="{Binding LocationId}" SelectedValuePath="Id" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_Grade}" />
                    <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Grades}" SelectedValue="{Binding GradeId}" SelectedValuePath="Id" />
                  </StackPanel>
                </Grid>
                <CheckBox Margin="{StaticResource FieldMargin}" Content="{x:Static res:Strings.Employee_Overtime}" IsChecked="{Binding IsOvertimeEligible}" />
                <CheckBox
                    Content="{x:Static res:Strings.Employee_StartConfirmed}"
                    IsChecked="{Binding StartConfirmed}"
                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="1" Grid.Column="1" Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Employee_Payment}" />
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_PaymentMode}" />
                  <ComboBox
                      DisplayMemberPath="Text"
                      ItemsSource="{x:Static vm:EmployeeDetailViewModel.PaymentModes}"
                      SelectedValue="{Binding PaymentMode}"
                      SelectedValuePath="Value" />
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_BankName}" />
                    <ui:TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_BankBranch}" />
                    <ui:TextBox Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_BankAccount}" />
                  <ui:TextBox Text="{Binding BankAccount, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Employee_TaxId}" />
                  <ui:TextBox Text="{Binding TaxIdentifier, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>
            </ui:Card>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Employment -->
      <TabItem Header="{x:Static res:Strings.Employee_TabEmployment}" IsEnabled="{Binding IsExisting}">
        <DockPanel Margin="0,12,0,0">
          <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
            <ui:Button
                Margin="0,0,8,8"
                Appearance="Primary"
                Command="{Binding ConfirmCommand}"
                Content="{x:Static res:Strings.Employee_Confirm}"
                Icon="{ui:SymbolIcon Checkmark20}"
                Visibility="{Binding IsOnProbation, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,8"
                Command="{Binding PromoteCommand}"
                Content="{x:Static res:Strings.Employee_Promote}"
                Icon="{ui:SymbolIcon ArrowTrendingLines20}"
                Visibility="{Binding HasLeft, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,8"
                Command="{Binding TransferCommand}"
                Content="{x:Static res:Strings.Employee_Transfer}"
                Icon="{ui:SymbolIcon ArrowSwap20}"
                Visibility="{Binding HasLeft, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,8"
                Command="{Binding AddNoteCommand}"
                Content="{x:Static res:Strings.Employee_AddNote}"
                Icon="{ui:SymbolIcon Note20}" />
            <ui:Button
                Margin="0,0,8,8"
                Appearance="Danger"
                Command="{Binding MarkLeftCommand}"
                Content="{x:Static res:Strings.Employee_MarkLeft}"
                Icon="{ui:SymbolIcon PersonDelete20}"
                Visibility="{Binding HasLeft, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button
                Margin="0,0,8,8"
                Command="{Binding RejoinCommand}"
                Content="{x:Static res:Strings.Employee_Rejoin}"
                Icon="{ui:SymbolIcon PersonAdd20}"
                Visibility="{Binding HasLeft, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>
          <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Employee_History}" />
          <DataGrid ItemsSource="{Binding History}" Style="{StaticResource ListGrid}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="110" Binding="{Binding Date, StringFormat=d}" Header="{x:Static res:Strings.Employee_ActionDate}" />
              <DataGridTextColumn Width="120" Binding="{Binding Type}" Header="{x:Static res:Strings.Audit_Action}" />
              <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{x:Static res:Strings.Audit_Summary}" />
              <DataGridTextColumn Width="120" Binding="{Binding CreatedBy}" Header="{x:Static res:Strings.Audit_User}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Documents -->
      <TabItem Header="{x:Static res:Strings.Employee_TabDocuments}" IsEnabled="{Binding IsExisting}">
        <DockPanel Margin="0,12,0,0">
          <ui:Button
              Margin="0,0,0,12"
              HorizontalAlignment="Left"
              Command="{Binding AddDocumentCommand}"
              Content="{x:Static res:Strings.Employee_AddDocument}"
              DockPanel.Dock="Top"
              Icon="{ui:SymbolIcon DocumentAdd20}"
              Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
          <DataGrid ItemsSource="{Binding Documents}" Style="{StaticResource ListGrid}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Binding="{Binding Title}" Header="{x:Static res:Strings.Employee_DocTitle}" />
              <DataGridTextColumn Width="*" Binding="{Binding FileName}" Header="{x:Static res:Strings.Employee_DocFile}" />
              <DataGridTextColumn Width="110" Binding="{Binding ExpiryDate, StringFormat=d}" Header="{x:Static res:Strings.Employee_DocExpiry}" />
              <DataGridTemplateColumn Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <ui:Button
                          Margin="0,0,6,0"
                          Padding="8,2"
                          Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.Employee_Open}" />
                      <ui:Button
                          Padding="8,2"
                          Appearance="Danger"
                          Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.App_Delete}"
                          Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
