<UserControl
    x:Class="SuperOfc.Desktop.Views.Devices.UnmappedPunchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel Margin="{StaticResource PagePadding}">
    <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
      <ui:Button Margin="0,0,12,0" Command="{Binding BackCommand}" DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowLeft20}" ToolTip="{x:Static res:Strings.App_Back}" />
      <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
    </DockPanel>
    <TextBlock Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Unmapped_Hint}" TextWrapping="Wrap" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <ui:Card
        Width="320"
        Margin="16,0,0,0"
        Padding="{StaticResource CardPadding}"
        VerticalAlignment="Top"
        DockPanel.Dock="Right"
        Visibility="{Binding Selected, Converter={StaticResource HasValueToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}">
          <Run Text="{x:Static res:Strings.Unmapped_UserId}" />
          <Run Text="{Binding Selected.DeviceUserId, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="0,2,0,10" Style="{StaticResource Caption}" Text="{Binding Selected.DeviceName}" />
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Unmapped_AssignTo}" />
          <ComboBox
              DisplayMemberPath="Name"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding Employees}"
              SelectedValue="{Binding AssignEmployeeId}"
              SelectedValuePath="Id"
              TextSearch.TextPath="Name" />
        </StackPanel>
        <CheckBox Margin="{StaticResource FieldMargin}" Content="{x:Static res:Strings.Unmapped_Remember}" IsChecked="{Binding Remember}" />
        <WrapPanel>
          <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding AssignCommand}" Content="{x:Static res:Strings.Unmapped_Assign}" />
          <ui:Button Margin="0,0,8,8" Appearance="Danger" Command="{Binding DiscardCommand}" Content="{x:Static res:Strings.Unmapped_Discard}" />
        </WrapPanel>
      </StackPanel>
    </ui:Card>

    <Grid>
      <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="*" Binding="{Binding DeviceName, TargetNullValue={x:Static res:Strings.Devices_FileImport}}" Header="{x:Static res:Strings.Devices_LogDevice}" />
          <DataGridTextColumn Width="110" Binding="{Binding DeviceUserId}" Header="{x:Static res:Strings.Unmapped_UserId}" />
          <DataGridTextColumn Width="80" Binding="{Binding Count}" Header="{x:Static res:Strings.Unmapped_Count}" />
          <DataGridTextColumn Width="140" Binding="{Binding First, StringFormat=g}" Header="{x:Static res:Strings.Unmapped_First}" />
          <DataGridTextColumn Width="140" Binding="{Binding Last, StringFormat=g}" Header="{x:Static res:Strings.Unmapped_Last}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.Unmapped_Empty}"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
