<UserControl
    x:Class="SuperOfc.Desktop.Views.Devices.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources"
    xmlns:vm="clr-namespace:SuperOfc.Desktop.ViewModels.Devices"
    x:Name="Root">
  <DockPanel Margin="{StaticResource PagePadding}">
    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding OpenUnmappedCommand}"
            Content="{x:Static res:Strings.Devices_Unmapped}"
            Icon="{ui:SymbolIcon PersonQuestionMark20}"
            Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding ImportFileCommand}"
            Content="{x:Static res:Strings.Devices_ImportFile}"
            Icon="{ui:SymbolIcon DocumentArrowUp20}"
            Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
            Margin="0,0,8,0"
            Command="{Binding SyncAllCommand}"
            Content="{x:Static res:Strings.Devices_SyncAll}"
            Icon="{ui:SymbolIcon ArrowSync20}"
            IsEnabled="{Binding IsSyncingAll, Converter={StaticResource InverseBool}}" />
        <ui:Button
            Appearance="Primary"
            Command="{Binding AddCommand}"
            Content="{x:Static res:Strings.Devices_Add}"
            Icon="{ui:SymbolIcon Add20}"
            Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <!-- Add / edit panel -->
    <ui:Card
        Width="360"
        Margin="16,0,0,0"
        Padding="{StaticResource CardPadding}"
        VerticalAlignment="Top"
        DockPanel.Dock="Right"
        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitle}" Text="{Binding EditTitle}" />
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Devices_Name}" />
          <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Devices_Ip}" />
            <ui:TextBox PlaceholderText="192.168.1.201" Text="{Binding EditIp, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Devices_Port}" />
            <ui:TextBox Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,-4,0,8" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Devices_IpHint}" TextWrapping="Wrap" />
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Devices_CommKey}" />
          <ui:PasswordBox Password="{Binding EditCommKey, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.Devices_CommKeyHint}" TextWrapping="Wrap" />
          <TextBlock
              Margin="0,2,0,0"
              Style="{StaticResource Caption}"
              Text="{x:Static res:Strings.Devices_CommKeyKeep}"
              TextWrapping="Wrap"
              Visibility="{Binding EditHasCommKey, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Devices_TimeZone}" />
          <ComboBox
              DisplayMemberPath="Text"
              ItemsSource="{x:Static vm:DevicesViewModel.TimeZones}"
              SelectedValue="{Binding EditTimeZoneId}"
              SelectedValuePath="Value" />
        </StackPanel>
        <CheckBox Margin="{StaticResource FieldMargin}" Content="{x:Static res:Strings.Devices_Enabled}" IsChecked="{Binding EditEnabled}" />
        <ui:Button Margin="0,0,0,8" Command="{Binding TestCommand}" Content="{x:Static res:Strings.Devices_Test}" Icon="{ui:SymbolIcon PlugConnected20}" />
        <TextBlock Margin="0,0,0,8" Text="{Binding TestResult}" TextWrapping="Wrap" Visibility="{Binding TestResult, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock.Style>
            <Style BasedOn="{StaticResource BodyText}" TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{x:Static res:Strings.App_Save}" />
          <ui:Button Command="{Binding CancelEditCommand}" Content="{x:Static res:Strings.App_Cancel}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock
          Margin="0,24"
          HorizontalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.Devices_Empty}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DeviceCard}">
            <ui:Card Width="340" Margin="0,0,12,12" Padding="{StaticResource CardPadding}" VerticalAlignment="Top">
              <StackPanel>
                <DockPanel>
                  <Border Background="{Binding Device.Status, Converter={StaticResource StatusBrush}}" DockPanel.Dock="Right" Style="{StaticResource Badge}">
                    <TextBlock FontSize="12" Text="{Binding Device.Status, Converter={StaticResource EnumText}, ConverterParameter=DeviceStatus}" />
                  </Border>
                  <ui:SymbolIcon Margin="0,0,8,0" FontSize="22" Symbol="Fingerprint24" />
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding Device.Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding LastSyncText}" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding UsersText}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding UnmappedText}"
                    Visibility="{Binding HasUnmapped, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource Caption}"
                    Text="{x:Static res:Strings.Devices_Disabled}"
                    Visibility="{Binding Device.IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding Device.StatusMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding Device.StatusMessage, Converter={StaticResource HasValueToVisibility}}" />
                <DockPanel Margin="0,6,0,0" Visibility="{Binding Device.HasClockDrift, Converter={StaticResource BoolToVisibility}}">
                  <ui:Button
                      Command="{Binding DataContext.FixClockCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Content="{x:Static res:Strings.Devices_FixClock}"
                      DockPanel.Dock="Right" />
                  <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ClockText}" TextWrapping="Wrap" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                  <ui:Button
                      Margin="0,0,6,6"
                      Appearance="Primary"
                      Command="{Binding DataContext.SyncCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Icon="{ui:SymbolIcon ArrowSync20}"
                      IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBool}}">
                    <ui:Button.Style>
                      <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                        <Setter Property="Content" Value="{x:Static res:Strings.Devices_SyncNow}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                            <Setter Property="Content" Value="{x:Static res:Strings.Devices_Syncing}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:Button.Style>
                  </ui:Button>
                  <ui:Button
                      Margin="0,0,6,6"
                      Command="{Binding DataContext.OpenUsersCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Content="{x:Static res:Strings.Devices_Users}"
                      Visibility="{Binding DataContext.CanManage, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                  <ui:Button
                      Margin="0,0,6,6"
                      Command="{Binding DataContext.EditCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Icon="{ui:SymbolIcon Edit20}"
                      ToolTip="{x:Static res:Strings.Devices_Edit}"
                      Visibility="{Binding DataContext.CanManage, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                  <ui:Button
                      Margin="0,0,6,6"
                      Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Icon="{ui:SymbolIcon Delete20}"
                      ToolTip="{x:Static res:Strings.App_Delete}"
                      Visibility="{Binding DataContext.CanManage, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="1" Margin="0,8,0,8" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Devices_SyncLog}" />
      <DataGrid Grid.Row="2" ItemsSource="{Binding SyncLog}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="140" Binding="{Binding StartedAtUtc, Converter={StaticResource LocalTime}, StringFormat=g}" Header="{x:Static res:Strings.Devices_LogStarted}" />
          <DataGridTextColumn Width="*" Binding="{Binding DeviceName, TargetNullValue={x:Static res:Strings.Devices_FileImport}}" Header="{x:Static res:Strings.Devices_LogDevice}" />
          <DataGridTextColumn Width="90" Binding="{Binding Trigger, Converter={StaticResource EnumText}, ConverterParameter=SyncTrigger}" Header="{x:Static res:Strings.Devices_LogTrigger}" />
          <DataGridTextColumn Width="70" Binding="{Binding Pulled}" Header="{x:Static res:Strings.Devices_LogPulled}" />
          <DataGridTextColumn Width="70" Binding="{Binding Inserted}" Header="{x:Static res:Strings.Devices_LogInserted}" />
          <DataGridTextColumn Width="90" Binding="{Binding Duplicates}" Header="{x:Static res:Strings.Devices_LogDuplicates}" />
          <DataGridTextColumn Width="80" Binding="{Binding Unmapped}" Header="{x:Static res:Strings.Devices_LogUnmapped}" />
          <DataGridTemplateColumn Width="2*" Header="{x:Static res:Strings.Devices_LogResult}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="CheckmarkCircle16" Visibility="{Binding Succeeded, Converter={StaticResource BoolToVisibility}}" />
                  <ui:SymbolIcon Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle16" Visibility="{Binding Succeeded, Converter={StaticResource InverseBoolToVisibility}}" />
                  <TextBlock Text="{Binding Error}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" />
                  <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Warning}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Warning}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
