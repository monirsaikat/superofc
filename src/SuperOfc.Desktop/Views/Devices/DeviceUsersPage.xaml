<UserControl
    x:Class="SuperOfc.Desktop.Views.Devices.DeviceUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <DockPanel Margin="{StaticResource PagePadding}">
    <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
      <ui:Button Margin="0,0,12,0" Command="{Binding BackCommand}" DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowLeft20}" ToolTip="{x:Static res:Strings.App_Back}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Command="{Binding AutoMapCommand}" Content="{x:Static res:Strings.DeviceUsers_AutoMap}" Icon="{ui:SymbolIcon LinkSquare20}" />
        <ui:Button Margin="0,0,8,0" Command="{Binding BackupCommand}" Content="{x:Static res:Strings.DeviceUsers_BackupFingers}" Icon="{ui:SymbolIcon Fingerprint20}" />
        <ui:Button Appearance="Primary" Command="{Binding PushMissingCommand}" Content="{x:Static res:Strings.DeviceUsers_PushMissing}" Icon="{ui:SymbolIcon PersonArrowRight20}" />
      </StackPanel>
      <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
    </DockPanel>
    <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding Summary}" TextWrapping="Wrap" />
    <TextBlock
        Margin="0,0,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource ErrorText}"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

    <StackPanel Width="320" Margin="16,0,0,0" DockPanel.Dock="Right">
      <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static res:Strings.DeviceUsers_SelectHint}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
          <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Selected.NameOnDevice}" />
            <TextBlock Margin="0,2,0,10" Style="{StaticResource Caption}">
              <Run Text="{x:Static res:Strings.DeviceUsers_Id}" />
              <Run Text="{Binding Selected.DeviceUserId, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.DeviceUsers_LinkTo}" />
              <ComboBox
                  DisplayMemberPath="Name"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  ItemsSource="{Binding Employees}"
                  SelectedValue="{Binding LinkEmployeeId}"
                  SelectedValuePath="Id"
                  TextSearch.TextPath="Name" />
            </StackPanel>
            <WrapPanel>
              <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding LinkCommand}" Content="{x:Static res:Strings.DeviceUsers_Link}" />
              <ui:Button Margin="0,0,8,8" Command="{Binding UnlinkCommand}" Content="{x:Static res:Strings.DeviceUsers_Unlink}" />
              <ui:Button Margin="0,0,8,8" Appearance="Danger" Command="{Binding DeleteFromDeviceCommand}" Content="{x:Static res:Strings.DeviceUsers_DeleteFromDevice}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="{StaticResource CardPadding}" Visibility="{Binding OtherDevices.Count, Converter={StaticResource HasValueToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.DeviceUsers_CopyTo}" />
          <DockPanel>
            <ui:Button Margin="8,0,0,0" Command="{Binding CopyToDeviceCommand}" Content="{x:Static res:Strings.DeviceUsers_Copy}" DockPanel.Dock="Right" />
            <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding OtherDevices}" SelectedValue="{Binding CopyTargetId}" SelectedValuePath="Id" />
          </DockPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>

    <Grid>
      <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="80" Binding="{Binding DeviceUserId}" Header="{x:Static res:Strings.DeviceUsers_Id}" />
          <DataGridTextColumn Width="*" Binding="{Binding NameOnDevice}" Header="{x:Static res:Strings.DeviceUsers_NameOnDevice}" />
          <DataGridTextColumn Width="60" Binding="{Binding FingerCount}" Header="{x:Static res:Strings.DeviceUsers_Fingers}" />
          <DataGridTextColumn Width="80" Binding="{Binding EmployeeCode}" Header="{x:Static res:Strings.Employees_Code}" />
          <DataGridTextColumn Width="*" Binding="{Binding EmployeeName}" Header="{x:Static res:Strings.DeviceUsers_Employee}" />
          <DataGridTextColumn Width="90" Binding="{Binding Match, Converter={StaticResource EnumText}, ConverterParameter=DeviceUserMatch}" Header="{x:Static res:Strings.DeviceUsers_Match}" />
          <DataGridCheckBoxColumn Width="70" Binding="{Binding HasBackup, Mode=OneWay}" Header="{x:Static res:Strings.DeviceUsers_Backup}" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{x:Static res:Strings.DeviceUsers_Empty}"
          TextWrapping="Wrap"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
