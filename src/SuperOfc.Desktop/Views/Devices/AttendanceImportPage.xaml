<UserControl
    x:Class="SuperOfc.Desktop.Views.Devices.AttendanceImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:SuperOfc.Desktop.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" Margin="{StaticResource PagePadding}" HorizontalAlignment="Left">
      <DockPanel Margin="0,0,0,8">
        <ui:Button Margin="0,0,12,0" Command="{Binding BackCommand}" DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowLeft20}" ToolTip="{x:Static res:Strings.App_Back}" />
        <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      </DockPanel>
      <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="{x:Static res:Strings.AttImport_Hint}" TextWrapping="Wrap" />

      <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}">
        <StackPanel>
          <DockPanel>
            <ui:Button Command="{Binding ChooseFileCommand}" Content="{x:Static res:Strings.AttImport_Choose}" DockPanel.Dock="Left" Icon="{ui:SymbolIcon FolderOpen20}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDeviceExport, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.AttImport_Device}" />
            <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Devices}" SelectedValue="{Binding DeviceId}" SelectedValuePath="Id" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{x:Static res:Strings.AttImport_DeviceHint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <TextBlock
          Margin="0,0,0,12"
          Style="{StaticResource ErrorText}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap"
          Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

      <ui:Card Margin="0,0,0,12" Padding="{StaticResource CardPadding}" Visibility="{Binding Preview, Converter={StaticResource HasValueToVisibility}}">
        <StackPanel>
          <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.AttImport_Preview}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,2" Text="{x:Static res:Strings.AttImport_Valid}" />
            <TextBlock Grid.Column="1" Margin="0,2" FontWeight="SemiBold" Text="{Binding Preview.Valid}" />
            <TextBlock Grid.Row="1" Margin="0,2" Text="{x:Static res:Strings.AttImport_Duplicates}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Preview.Duplicates}" />
            <TextBlock Grid.Row="2" Margin="0,2" Text="{x:Static res:Strings.AttImport_Unmapped}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Preview.Unmapped}" />
            <TextBlock Grid.Row="3" Margin="0,2" Text="{x:Static res:Strings.AttImport_Invalid}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Preview.Invalid}" />
            <TextBlock Grid.Row="4" Margin="0,2" Text="{x:Static res:Strings.AttImport_Range}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2">
              <Run Text="{Binding Preview.First, Mode=OneWay, StringFormat=d}" />
              <Run Text=" – " />
              <Run Text="{Binding Preview.Last, Mode=OneWay, StringFormat=d}" />
            </TextBlock>
          </Grid>
          <StackPanel Margin="0,10,0,0" Visibility="{Binding Preview.UnmappedIds.Count, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.AttImport_UnmappedIds}" />
            <ItemsControl ItemsSource="{Binding Preview.UnmappedIds}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,6,6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Style="{StaticResource Badge}">
                    <TextBlock Text="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Preview.Errors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:Button
              Margin="0,12,0,0"
              Appearance="Primary"
              Command="{Binding ImportCommand}"
              Content="{x:Static res:Strings.AttImport_Import}"
              Icon="{ui:SymbolIcon ArrowImport20}"
              IsEnabled="{Binding CanImport}" />
        </StackPanel>
      </ui:Card>

      <ui:Card Padding="{StaticResource CardPadding}" Visibility="{Binding ResultText, Converter={StaticResource HasValueToVisibility}}">
        <DockPanel>
          <ui:Button Command="{Binding OpenUnmappedCommand}" Content="{x:Static res:Strings.Devices_Unmapped}" DockPanel.Dock="Right" />
          <TextBlock VerticalAlignment="Center" Text="{Binding ResultText}" TextWrapping="Wrap" />
        </DockPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
